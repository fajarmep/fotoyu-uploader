    def _build_leaderboard_tab(self):
        tab_lb = ttk.Frame(self.nb, padding=(10, 10, 10, 10))
        self.nb.add(tab_lb, text="  Leaderboard  ")

        # Bar Kontrol Atas (Pilihan Tanggal atau Fototree + Tombol Ekspor)
        lb_bar = ttk.Frame(tab_lb)
        lb_bar.pack(fill="x", pady=(0, 10))

        ttk.Label(lb_bar, text="Kategori Leaderboard:", font=FONT_BOLD, foreground="#0f172a").pack(side="left", padx=(0, 10))
        self.v_lb_mode = tk.StringVar(value="fototree")
        rb_tree = ttk.Radiobutton(
            lb_bar,
            text="Top 10 Fototree Terlaris",
            value="fototree",
            variable=self.v_lb_mode,
            command=self._render_leaderboard,
        )
        rb_tree.pack(side="left", padx=(0, 14))

        rb_date = ttk.Radiobutton(
            lb_bar,
            text="Top 10 Tanggal Terlaris",
            value="date",
            variable=self.v_lb_mode,
            command=self._render_leaderboard,
        )
        rb_date.pack(side="left", padx=(0, 14))

        ModernButton(lb_bar, text="Ekspor Leaderboard", variant="soft_blue", px_width=150, command=self.on_export_leaderboard).pack(side="right")

        # Kontainer Utama: Kiri (Grafik) dan Kanan (Tabel Detail Ranking)
        lb_body = ttk.Frame(tab_lb)
        lb_body.pack(fill="both", expand=True)

        lb_left = ttk.Frame(lb_body)
        lb_left.pack(side="left", fill="both", expand=True, padx=(0, 12))

        # Panel Grafik Menyamping (Horizontal Bar Chart)
        chart_border = tk.Frame(lb_left, bg="#e2e8f0", bd=0, highlightthickness=0)
        chart_border.pack(fill="both", expand=True)

        chart_outer = tk.Frame(chart_border, bg="#ffffff", bd=0, highlightthickness=0)
        chart_outer.pack(fill="both", expand=True, padx=1, pady=1)

        c_hdr = tk.Frame(chart_outer, bg="#f8fafc", padx=10, pady=6, bd=0, highlightthickness=0)
        c_hdr.pack(fill="x")
        self.v_lb_chart_title = tk.StringVar(value="Grafik Top 10 Fototree Terlaris (Berdasarkan Penjualan)")
        tk.Label(c_hdr, textvariable=self.v_lb_chart_title, font=FONT_BOLD, fg="#0f172a", bg="#f8fafc").pack(side="left")
        tk.Frame(chart_outer, height=1, bg="#e2e8f0", bd=0, highlightthickness=0).pack(fill="x")

        self.canvas_lb = tk.Canvas(chart_outer, bg="#ffffff", highlightthickness=0)
        self.canvas_lb.pack(fill="both", expand=True, padx=6, pady=6)
        self.canvas_lb.bind("<Configure>", lambda e: self._draw_lb_chart())

        # ---- Kanan: Tabel Detail Ranking (Lebar 420px agar seluruh kolom pas dan tidak terpotong) ----
        lb_right = ttk.Frame(lb_body, width=420)
        lb_right.pack(side="right", fill="both")
        lb_right.pack_propagate(False)

        r_border = tk.Frame(lb_right, bg="#e2e8f0", bd=0, highlightthickness=0)
        r_border.pack(fill="both", expand=True)

        r_outer = tk.Frame(r_border, bg="#ffffff", bd=0, highlightthickness=0)
        r_outer.pack(fill="both", expand=True, padx=1, pady=1)

        r_hdr = tk.Frame(r_outer, bg="#f8fafc", padx=10, pady=6, bd=0, highlightthickness=0)
        r_hdr.pack(fill="x")
        self.v_lb_tbl_title = tk.StringVar(value="Tabel Top 10 Ranking")
        tk.Label(r_hdr, textvariable=self.v_lb_tbl_title, font=FONT_BOLD, fg="#0f172a", bg="#f8fafc").pack(side="left")
        tk.Frame(r_outer, height=1, bg="#e2e8f0", bd=0, highlightthickness=0).pack(fill="x")

        tbl_lb_frame = ttk.Frame(r_outer)
        tbl_lb_frame.pack(fill="both", expand=True)

        lb_cols = ("rank", "name", "sold", "rev", "share")
        self.tree_lb = ttk.Treeview(tbl_lb_frame, columns=lb_cols, show="headings", selectmode="browse")
        self.tree_lb.tag_configure("even", background="#ffffff")
        self.tree_lb.tag_configure("odd", background="#f8fafc")
        self.tree_lb.tag_configure("rank1", foreground="#d97706")

        lb_headers = [
            ("rank", "#", 36, "center"),
            ("name", "Nama", 130, "w"),
            ("sold", "Terjual", 65, "center"),
            ("rev", "Est. Net", 95, "center"),
            ("share", "Pangsa", 60, "center"),
        ]
        self._lb_base_headers = {}
        for cid, ctext, cw, canchor in lb_headers:
            self.tree_lb.heading(cid, text=ctext)
            self.tree_lb.column(cid, width=cw, anchor=canchor)
            self._lb_base_headers[cid] = ctext

        setup_tree_grid_lines(self.tree_lb, lb_cols)
        setup_tree_sorting(self.tree_lb, self._lb_base_headers)

        lb_vsb = ttk.Scrollbar(tbl_lb_frame, orient="vertical", command=self.tree_lb.yview)
