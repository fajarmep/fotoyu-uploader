def format_idr(amount):
    """Format angka rupiah rapi: Rp 35.000."""
    try:
        n = int(round(float(amount)))
        return f"Rp {n:,}".replace(",", ".")
    except Exception:
        return "Rp 0"


def format_eta(seconds):
    """Format estimasi waktu selesai secara ringkas (mis. 1j 12m, 3m 20d, 45d)."""
    try:
        sec = int(max(0, round(seconds)))
        if sec >= 3600:
            h = sec // 3600
            m = (sec % 3600) // 60
            return f"{h}j {m}m"
        if sec >= 60:
            m = sec // 60
            s = sec % 60
            return f"{m}m {s}d"
        return f"{sec}d"
    except Exception:
        return "-"


def format_bytes_human(num_bytes):
    """Format ukuran byte ke KB / MB / GB yang mudah dibaca."""
    try:
        v = float(num_bytes)
        if v >= 1024 ** 3:
            return f"{v / (1024 ** 3):.2f} GB"
        if v >= 1024 ** 2:
            return f"{v / (1024 ** 2):.1f} MB"
        if v >= 1024:
            return f"{v / 1024:.1f} KB"
        return f"{int(v)} B"
    except Exception:
        return "-"


def parse_storage_data(raw):
    """Parse defensif hasil endpoint /gs/v1/creators/storage menjadi dict info storage terstruktur."""
    if not isinstance(raw, dict):
        return {"used": None, "limit": None, "pct": 0.0, "text": "", "used_str": "", "limit_str": ""}
    res = raw.get("result", raw)
    if isinstance(res, dict) and isinstance(res.get("data"), dict):
        res = res["data"]
    if not isinstance(res, dict):
        return {"used": None, "limit": None, "pct": 0.0, "text": "", "used_str": "", "limit_str": ""}

    def pick_num(keys):
        for k in keys:
            val = res.get(k)
            if isinstance(val, (int, float)):
                return float(val)
            if isinstance(val, str):
                try:
                    return float(val)
                except ValueError:
                    pass
        return None

    used = pick_num(("used_storage", "used", "storage_used", "used_size", "used_bytes", "current_usage", "usage"))
    limit = pick_num(("limit_storage", "limit", "max_storage", "storage_limit", "total", "total_storage", "quota", "max_size", "limit_bytes", "capacity"))
    bonus = pick_num(("bonus_storage", "bonus", "extra_storage"))
    if limit is not None and bonus is not None and bonus > 0:
        limit += bonus
    pct = pick_num(("percentage", "used_percentage", "percent"))

    unit = str(res.get("unit") or "").upper()
    def fmt_val(v):
        if v is None:
            return ""
        if unit in ("GB", "MB", "TB"):
            return f"{v:.2f} {unit}"
        if v > 10000:
            return format_bytes_human(v)
        return f"{v:.2f} GB"

    used_str = fmt_val(used)
    limit_str = fmt_val(limit)
    calc_pct = 0.0

    if used is not None and limit is not None and limit > 0:
        if pct is None:
            calc_pct = (used / limit) * 100.0
        else:
            calc_pct = float(pct)
        calc_pct = min(100.0, max(0.0, calc_pct))
        txt = f"{used_str} / {limit_str} ({calc_pct:.1f}%)"
    elif used is not None:
        txt = f"{used_str} terpakai"
    elif limit is not None:
        txt = f"Kuota: {limit_str}"
    else:
        txt = ""

    return {
        "used": used,
        "limit": limit,
        "pct": calc_pct,
        "used_str": used_str,
        "limit_str": limit_str,
        "text": txt,
    }


def parse_storage_summary(raw):
    """Kompatibilitas mundur: mengembalikan teks string ringkas storage."""
    return parse_storage_data(raw).get("text", "")


def parse_fee_summary(raw, price):
    """Parse defensif hasil /payment/v2/transactions/fee -> (net_amount, fee_amount)."""
    if not isinstance(raw, dict):
        return None, None
    res = raw.get("result", raw)
    if isinstance(res, dict) and isinstance(res.get("data"), dict):
        res = res["data"]
    if not isinstance(res, dict):
        return None, None

    net = None
    fee = None

    # 1. Parse dari struktur real FotoYu API (/payment/v2/transactions/fee)
    p_dict = res.get("price")
    if isinstance(p_dict, dict):
        for ch in ("web", "google", "apple"):
            c = p_dict.get(ch)
            if isinstance(c, dict):
                nc = c.get("net_creator")
                if isinstance(nc, dict) and isinstance(nc.get("nominal"), (int, float)):
                    net = float(nc["nominal"])
                    break
                elif isinstance(c.get("nominal"), (int, float)) and net is None:
                    net = float(c["nominal"])

    f_dict = res.get("fotoyu_fee") or res.get("platform_fee") or res.get("service_fee")
    if isinstance(f_dict, dict):
        for ch in ("web", "google", "apple"):
            c = f_dict.get(ch)
            if isinstance(c, dict):
                nom = c.get("nominal")
                if isinstance(nom, (int, float)):
                    fee = float(nom)
                    break

    # 2. Fallback parser untuk format flat
    def pick_num(keys):
        for k in keys:
            val = res.get(k)
            if isinstance(val, (int, float)):
                return float(val)
            if isinstance(val, str):
                try:
                    return float(val)
                except ValueError:
                    pass
        return None

    if net is None:
        net = pick_num(("net_amount", "creator_amount", "creator_earning", "earning", "net_price", "net", "received", "income", "subtotal", "amount_received"))
    if fee is None:
        fee = pick_num(("total_fee", "fee", "platform_fee", "admin_fee", "service_fee", "fee_amount", "deduction", "fotoyu_fee"))
    pct = pick_num(("fee_percentage", "percentage", "rate"))

    if net is None and fee is not None and price > 0:
        net = max(0.0, float(price) - fee)
    elif fee is None and net is not None and price > 0:
        fee = max(0.0, float(price) - net)
    elif net is None and fee is None and pct is not None and price > 0:
        fee = float(price) * (pct / 100.0 if pct > 1 else pct)
        net = max(0.0, float(price) - fee)
    elif net is None and fee is None and price > 0:
        # Fallback default jika endpoint fee offline/gagal: fee FotoYu standar 15.8%
        fee = round(float(price) * 0.158)
        net = max(0.0, float(price) - fee)

    if net is None and fee is None:
        return None, None
    return net, fee


def extract_fototree_name(item):
    """Mengekstrak nama Fototree dari objek creation atau group secara defensif."""
    if not isinstance(item, dict):
        return ""
    if item.get("fototree"):
        return str(item["fototree"]).strip()
    if item.get("tree_name"):
        return str(item["tree_name"]).strip()
    tags = item.get("tags")
    if isinstance(tags, list):
        for t in tags:
            if isinstance(t, dict):
                tname = t.get("name") or t.get("tree_name")
                if tname:
                    return str(tname).strip()
            elif isinstance(t, str) and t.strip():
                return t.strip()
    nicknames = item.get("tag_nicknames")
    if isinstance(nicknames, list):
        for nick in nicknames:
            if nick and str(nick).strip():
                return str(nick).strip()
    loc = item.get("location")
    if isinstance(loc, dict) and loc.get("name"):
        return str(loc["name"]).strip()
    elif isinstance(loc, str) and loc.strip():
        try:
            loc_data = json.loads(loc)
            if isinstance(loc_data, dict) and loc_data.get("name"):
                return str(loc_data["name"]).strip()
        except Exception:
            pass
        return loc.strip()
    return ""


def get_robofind_label(item):
    """Tentukan status AI Robofind (Selesai / Proses) dari objek creation."""
    if not isinstance(item, dict):
        return "-"
    done = item.get("is_robofind_done")
    status = str(item.get("robofind_status") or "").lower().strip()
    if done is True or status in ("processed", "done", "completed", "success"):
        return "Selesai"
    if done is False or status in ("pending", "processing", "queued", "in_progress", "waiting"):
        return "Proses"
    return "Selesai" if (item.get("face_count", 0) or item.get("found_count", 0)) else "-"


def open_folder(path):
    try:
        if IS_WIN:
            os.startfile(path)  # noqa
        elif IS_MAC:
            subprocess.Popen(["open", path])
        else:
            subprocess.Popen(["xdg-open", path])
    except Exception:
        pass


def safe_move_file(src, dest, max_retries=3, delay=0.15):
    """Memindahkan file dengan retry untuk mencegah kendala temporary file-lock pada OS."""
    for attempt in range(max_retries):
        try:
            shutil.move(src, dest)
            return True
        except Exception:
            if attempt < max_retries - 1:
                time.sleep(delay)
    return False


def unique_path(directory, filename):
    base, ext = os.path.splitext(filename)
    candidate = os.path.join(directory, filename)
    i = 1
    while os.path.exists(candidate):
        candidate = os.path.join(directory, f"{base}_{i}{ext}")
        i += 1
    return candidate


def list_images(directory):
    try:
        files = []
        with os.scandir(directory) as entries:
            for entry in entries:
                if entry.is_file():
                    if entry.name.startswith("."):
                        continue
                    ext = os.path.splitext(entry.name)[1].lower()
                    if ext in IMAGE_EXTS_SET:
                        files.append(entry.path)
        files.sort()
        return files
    except Exception:
        return []


def is_file_stable(path, min_age=FILE_STABLE_AGE):
    try:
        stat = os.stat(path)
        if stat.st_size == 0:
            return False
        if (time.time() - stat.st_mtime) < min_age:
            return False
        with open(path, "rb") as f:
            if stat.st_size > 1024:
                f.seek(-1024, os.SEEK_END)
                _ = f.read(1024)
        return True
    except (OSError, PermissionError):
        return False


def get_file_fingerprint(path):
    try:
        stat = os.stat(path)
        size = stat.st_size
        if size == 0:
            return None
        h = hashlib.md5()
        h.update(str(size).encode())
        with open(path, "rb") as f:
            h.update(f.read(32768))
            if size > 65536:
                f.seek(-32768, os.SEEK_END)
                h.update(f.read(32768))
        return f"{size}_{h.hexdigest()}"
    except Exception:
        return None


def get_file_md5(file_path):
    h = hashlib.md5()
    with open(file_path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def get_file_timestamps(file_path):
    try:
        mtime = os.path.getmtime(file_path)
    except Exception:
        mtime = time.time()
    dt = datetime.fromtimestamp(mtime, tz=timezone.utc)
    return dt.strftime("%Y-%m-%dT%H:%M:%S.000Z"), int(mtime)


def flatten_alpha(img):
    if img.mode in ("RGBA", "LA") or (img.mode == "P" and "transparency" in img.info):
        rgba = img.convert("RGBA")
        bg = Image.new("RGB", rgba.size, (255, 255, 255))
        bg.paste(rgba, mask=rgba.split()[-1])
        return bg
    return img if img.mode == "RGB" else img.convert("RGB")


def quality_sequence(start=cR7_START_QUALITY, min_q=cR7_MIN_QUALITY):
    q = start
    while q >= min_q:
        yield q
        q -= 5 if q > 60 else 10


def trailing_number(filename):
    m = re.findall(r"\d+", os.path.splitext(filename)[0])
    return int(m[-1]) if m else None


def mode_match(filename, index, mode):
    if mode == "all":
        return True
    n = trailing_number(filename)
    if n is None:
        n = index
    return (n % 2 == 1) if mode == "odd" else (n % 2 == 0)


def extract_token(data):
    if isinstance(data, str):
        return data
    if isinstance(data, dict):
        for key in ("token", "access_token", "jwt", "authorization"):
            if data.get(key):
                val = data[key]
                if isinstance(val, str):
                    return val
                r = extract_token(val)
                if r:
                    return r
        for v in data.values():
            r = extract_token(v)
            if r:
                return r
    elif isinstance(data, list):
        for item in data:
            r = extract_token(item)
            if r:
                return r
    return None


def parse_trees(items):
    out = []
    for it in items or []:
        if not isinstance(it, dict):
            continue
        name = it.get("name")
        tag_id = it.get("tag_id") or it.get("id")
        loc = it.get("location") or {}
        if name and tag_id:
            out.append({
                "name": name,
                "tag_id": tag_id,
                "location_name": loc.get("name") or name,
                "longitude": loc.get("longitude"),
                "latitude": loc.get("latitude"),
            })
    return out


def build_session():
    s = requests.Session()
    retry = Retry(total=4, backoff_factor=0.8,
                  status_forcelist=(429, 500, 502, 503, 504),
                  allowed_methods=frozenset(["GET", "POST", "PUT"]))
    ad = HTTPAdapter(max_retries=retry, pool_connections=30, pool_maxsize=30)
    s.mount("https://", ad)
    s.mount("http://", ad)
    return s


# ============================================================
#  KOMPRESI
# ============================================================
def compress_image(src_path, dst_path):
    try:
        with Image.open(src_path) as img:
            w_orig, h_orig = img.size
            if w_orig * h_orig > JTH_MAX_INPUT_PIXELS:
                return False, None, None, None, None
            longest_orig = max(w_orig, h_orig)
            if longest_orig > I8V_MAX_DIMENSION:
                try:
                    img.draft("RGB", (I8V_MAX_DIMENSION * 2, I8V_MAX_DIMENSION * 2))
                except Exception:
                    pass

            try:
                img = ImageOps.exif_transpose(img)
            except Exception:
                pass
            img = flatten_alpha(img)
            width, height = img.size
            longest = max(width, height)
            if longest > I8V_MAX_DIMENSION:
                scale = I8V_MAX_DIMENSION / float(longest)
                new_size = (max(1, round(width * scale)), max(1, round(height * scale)))
                img = img.resize(new_size, Image.Resampling.BICUBIC)
                width, height = img.size

            for q in quality_sequence():
                buf = io.BytesIO()
                try:
                    img.save(buf, "JPEG", quality=q)
                    size = buf.tell()
                    if size <= MAX_OUTPUT_BYTES:
                        tmp = dst_path + ".part"
                        with open(tmp, "wb") as f:
                            f.write(buf.getvalue())
                        os.replace(tmp, dst_path)
                        return True, q, size, width, height
                finally:
                    buf.close()
    except Exception:
        pass
    return False, None, None, None, None


# ============================================================
#  API FOTOYU
# ============================================================
class FotoyuApi:
    def __init__(self):
        self.session = build_session()
        self.token = None
        self._lock = threading.Lock()

    def login(self, username, password):
        try:
            with self.session.post(f"{BASE_URL}/gs/v2/auth/login",
                                  json={"identifier": username, "password": password},
                                  headers=HEADERS_BASE, timeout=30) as r:
                if r.status_code == 200:
                    return extract_token(r.json())
        except Exception:
            pass
        return None

    def set_token(self, token):
        with self._lock:
            self.token = token

    def get_token(self):
        with self._lock:
            return self.token

    def tree_search(self, query):
        token = self.get_token()
        if not token:
            return None
        headers = dict(HEADERS_BASE)
        headers["Authorization"] = f"Bearer {token}"
        try:
            with self.session.get(f"{BASE_URL}/tree/v1/trees/search",
                                 params={"page": 1, "limit": 20, "name": query, "is_upload": True},
                                 headers=headers, timeout=20) as r:
                if r.status_code == 401:
                    self.set_token(None)
                    return None
                if r.status_code == 200:
                    data = r.json()
                    res = data.get("result", data)
                    items = res.get("data") if isinstance(res, dict) else res
                    return items or []
        except Exception:
            pass
        return []

    def presigned_urls(self, items):
        token = self.get_token()
        if not token:
            return [], {}, True
        headers = dict(HEADERS_BASE)
        headers["Authorization"] = f"Bearer {token}"
        payload = []
        meta_map = {}
        for meta in items:
            sig = meta["signature"]
            meta_map.setdefault(sig, []).append(meta)
            payload.append({"height": meta["height"], "width": meta["width"],
                            "size": meta["size"], "extension": meta["ext"],
                            "file": {}, "signature": sig})
        try:
            with self.session.post(f"{BASE_URL}/gs/v3/creations/link",
                                  json={"contents": payload}, headers=headers, timeout=TIMEOUT) as r:
                if r.status_code in (200, 201):
                    return r.json().get("result", []), meta_map, False
                if r.status_code == 401:
                    self.set_token(None)
                    return [], meta_map, True
        except Exception:
            pass
        return [], meta_map, False

    def upload_s3(self, url, path, width, height, content_type):
        headers = {
            "User-Agent": HEADERS_BASE["User-Agent"],
            "Content-Type": content_type,
            "x-amz-meta-imagewidth": str(width),
            "x-amz-meta-imageheight": str(height),
        }
        with open(path, "rb") as f:
            data = f.read()
        try:
            with self.session.put(url, data=data, headers=headers, timeout=TIMEOUT) as r:
                return r.status_code in (200, 201), r.status_code
        except Exception:
            return False, None

    def finalize(self, contents, ref_path, price, location_str, description, currency_id, tag_id):
        token = self.get_token()
        if not token:
            return False
        headers = dict(HEADERS_BASE)
        headers["Authorization"] = f"Bearer {token}"
        iso_time, unix_time = get_file_timestamps(ref_path)
        body = {
            "currency_id": currency_id,
            "location": location_str,
            "description": description,
            "original_at": iso_time,
            "unix_original_at": unix_time,
            "is_bibs": [{"tag_id": tag_id, "is_bib": False}],
            "nickname": [],
            "price": price,
            "resend": True,
            "tag_ids": [tag_id],
            "contents": contents,
        }
        self.last_finalize_error = ""
        try:
            with self.session.post(f"{BASE_URL}/gs/v4/creations", json=body,
                                  headers=headers, timeout=TIMEOUT) as r:
                if r.status_code == 401:
                    self.set_token(None)
                if r.status_code in (200, 201):
                    return True
                try:
                    msg = r.json().get("message") or r.text[:120]
                except Exception:
                    msg = r.text[:120]
                self.last_finalize_error = f"HTTP {r.status_code}: {msg}"
                return False
        except Exception as e:
            self.last_finalize_error = str(e)
            return False

    # --- Metode Statistik Akun FotoYu ---
    def get_groups(self, limit=50, filter_type="all"):
        """Mengambil daftar folder tanggal pembuatan."""
        token = self.get_token()
        if not token:
            return None
        headers = dict(HEADERS_BASE)
        headers["Authorization"] = f"Bearer {token}"
        try:
            with self.session.get(
                f"{BASE_URL}/gs/v4/creations/groups",
                params={"limit": limit, "filter": filter_type, "sort_by": "created_at", "sort_dir": "desc", "content_type": "all"},
                headers=headers, timeout=25
            ) as r:
                if r.status_code == 401:
                    self.set_token(None)
                    return None
                if r.status_code == 200:
                    data = r.json()
                    return data.get("result", {}).get("group_data", [])
        except Exception:
            pass
        return []

    def get_date_counts(self, date_str):
        """Mengambil total foto, terjual, dan status untuk tanggal tertentu."""
        token = self.get_token()
        if not token:
            return {}
        headers = dict(HEADERS_BASE)
        headers["Authorization"] = f"Bearer {token}"
        try:
            with self.session.get(
                f"{BASE_URL}/gs/v1/creations/counts",
                params={"date": date_str, "filter": "all,available"},
                headers=headers, timeout=20
            ) as r:
                if r.status_code == 200:
                    return r.json().get("result", {})
        except Exception:
            pass
        return {}

    def get_creations_page(self, date_str, page=1, limit=100, filter_type="available"):
        """Mengambil rincian foto dan metrik wajah pada tanggal tertentu (paginated)."""
        token = self.get_token()
        if not token:
            return None
        headers = dict(HEADERS_BASE)
        headers["Authorization"] = f"Bearer {token}"
        try:
            with self.session.get(
                f"{BASE_URL}/gs/v5/creations",
                params={
                    "page": page,
                    "limit": limit,
                    "filter": filter_type,
                    "sort_by": "created_at",
                    "sort_dir": "desc",
                    "date": date_str
                },
                headers=headers, timeout=30
            ) as r:
                if r.status_code == 401:
                    self.set_token(None)
                    return None
                if r.status_code == 200:
                    data = r.json()
                    return data.get("result", {}).get("data", [])
        except Exception:
            pass
        return []

    def get_sold_creations(self, limit=200):
        """Mengambil daftar foto yang telah terjual."""
        token = self.get_token()
        if not token:
            return []
        headers = dict(HEADERS_BASE)
        headers["Authorization"] = f"Bearer {token}"
        try:
            with self.session.get(
                f"{BASE_URL}/gs/v5/creations",
                params={"page": 1, "limit": limit, "filter": "sold", "sort_by": "purchased_at", "sort_dir": "desc"},
                headers=headers, timeout=25
            ) as r:
                if r.status_code == 200:
                    return r.json().get("result", {}).get("data", [])
        except Exception:
            pass
        return []

    def get_creation_details(self, content_id):
        """Mengambil detail lengkap satu creation (price, tags, fototree, location)."""
        token = self.get_token()
        if not token or not content_id:
            return {}
        headers = dict(HEADERS_BASE)
        headers["Authorization"] = f"Bearer {token}"
        try:
            with self.session.get(
                f"{BASE_URL}/gs/v4/creations/details",
                params={"content_id": content_id},
                headers=headers, timeout=15
            ) as r:
                if r.status_code == 200:
                    data = r.json()
                    return data.get("result", {})
        except Exception:
            pass
        return {}

    def get_storage(self):
        """Mengambil info kuota penyimpanan kreator (/gs/v1/creators/storage)."""
        token = self.get_token()
        if not token:
            return {}
        headers = dict(HEADERS_BASE)
        headers["Authorization"] = f"Bearer {token}"
        try:
            with self.session.get(f"{BASE_URL}/gs/v1/creators/storage", headers=headers, timeout=15) as r:
                if r.status_code == 200:
                    return r.json()
        except Exception:
            pass
        return {}

    def get_transaction_fee(self, price, tag_id=None):
        """Mengambil simulasi potongan fee & pendapatan bersih (/payment/v2/transactions/fee)."""
        token = self.get_token()
        if not token:
            return {}
        headers = dict(HEADERS_BASE)
        headers["Authorization"] = f"Bearer {token}"
        params = {"price": int(price)}
        if tag_id:
            params["tag_id"] = tag_id
        try:
            with self.session.get(f"{BASE_URL}/payment/v2/transactions/fee", params=params, headers=headers, timeout=12) as r:
                if r.status_code == 200:
                    return r.json()
        except Exception:
            pass
        return {}

    def check_server_health(self):
        """Cek koneksi & status maintenance server FotoYu -> ('ok'|'maintenance'|'offline', msg)."""
        try:
            with self.session.get(f"{BASE_URL}/notification/v1/maintenance", headers=HEADERS_BASE, timeout=10) as r:
                if r.status_code == 503:
                    return "maintenance", "Server FotoYu sedang maintenance (503)."
                if r.status_code == 200:
                    try:
                        data = r.json()
                        res = data.get("result", data)
                        if isinstance(res, dict):
                            is_maint = (
                                res.get("is_maintenance") is True
                                or res.get("maintenance") is True
                                or res.get("active") is True
                                or str(res.get("status", "")).lower() == "maintenance"
                            )
                            if is_maint:
                                msg = res.get("message") or res.get("description") or "Server FotoYu sedang maintenance."
                                return "maintenance", str(msg)
                    except Exception:
                        pass
                return "ok", ""
        except (requests.ConnectionError, requests.Timeout):
            return "offline", "Koneksi internet terputus."
        except Exception:
            return "ok", ""


def resolve_link(item):
    key = item.get("upload_key") or item.get("key")
    for field in ("original_link", "original_url", "presigned_url", "upload_link", "link", "url"):
        v = item.get(field)
        if isinstance(v, str) and v.startswith("http"):
            return v, key
        if isinstance(v, dict):
            for sub in ("original_link", "url", "link"):
                if isinstance(v.get(sub), str):
                    return v[sub], key
    return None, key


def center_popup(child, parent=None, default_w=None, default_h=None):
    """
    Posisikan child window persis di tengah parent window (pixel-perfect center).
    Mendukung popup yang lebih besar maupun lebih kecil dari parent, serta mode compact.
    """
    try:
        child.update_idletasks()
        sw = child.winfo_screenwidth()
        sh = child.winfo_screenheight()
        if parent:
            parent.update_idletasks()
            pw = parent.winfo_width()
            ph = parent.winfo_height()
            px = parent.winfo_x()
            py = parent.winfo_y()
        else:
            pw, ph = sw, sh
            px, py = 0, 0

        ww = min(default_w or child.winfo_reqwidth(), max(300, sw - 40))
        wh = min(default_h or child.winfo_reqheight(), max(240, sh - 80))

        x = px + (pw - ww) // 2
        y = py + (ph - wh) // 2

        x = max(10, min(x, sw - ww - 10))
        y = max(30, min(y, sh - wh - 50))

        child.geometry(f"{ww}x{wh}+{x}+{y}")
    except Exception:
        pass


def bring_to_front(win, parent=None):
    if parent:
        try:
            win.transient(parent)
        except Exception:
            pass
    try:
        win.lift()
    except Exception:
        pass
    try:
        win.focus_force()
    except Exception:
        pass


def format_display_date(d_str):
    """
    Mengubah format tanggal YYYY-MM-DD menjadi DD-MM-YYYY saat tampil di program.
    Jika sudah berformat DD-MM-YYYY atau bukan tanggal, kembalikan string aslinya.
    """
    if not d_str or not isinstance(d_str, str):
        return str(d_str or "")
    s = d_str.strip()[:10]
    parts = s.split("-")
    if len(parts) == 3 and len(parts[0]) == 4:
        return f"{parts[2]}-{parts[1]}-{parts[0]}"
    return s


def setup_tree_grid_lines(tree, columns):
    """
    Garis pemisah kolom vertikal (1px) dimulai tepat di bawah header (y=hdr_h)
    dan bergeser -1px agar sejajar 100% presisi dengan separator header bawaan.
    Garis horizontal (1px) di bawah header sebagai pemisah header dan data.
    Border native di tepi paling kanan header ditutup agar kolom terakhir tidak ada border menggantung.
    Semua garis menggunakan warna yang seragam (#e2e8f0).
    """
    LINE_COLOR = "#e2e8f0"

    # Garis vertikal antar kolom (hanya di area baris data)
    v_lines = []
    for _ in range(len(columns) - 1):
        vl = tk.Frame(tree, width=1, bg=LINE_COLOR)
        vl.bind("<Button-1>", lambda e, l=vl, tv=tree: tv.event_generate(
            "<Button-1>", x=l.winfo_x() + e.x, y=l.winfo_y() + e.y
        ))
        v_lines.append(vl)

    # Garis horizontal di bawah header
    h_line = tk.Frame(tree, height=1, bg=LINE_COLOR)
    h_line.bind("<Button-1>", lambda e, tv=tree: tv.event_generate(
        "<Button-1>", x=e.x, y=e.y
    ))

    # Penutup border native di tepi paling kanan header
    right_cover = tk.Frame(tree, width=8, bg="#ffffff")

    def _get_boundaries():
        """
        Kembalikan list x-koordinat batas antar kolom (len = len(columns)-1).
        Prioritas: bbox dari baris pertama (100% akurat saat data ada atau saat kolom di-resize).
        Offset -1 diterapkan agar pas di tengah separator header visual.
        """
        children = tree.get_children("")
        if children:
            for child in children[:5]:
                b0 = tree.bbox(child, "#1")
                if b0:
                    bx_list = []
                    for i in range(1, len(columns)):
                        b = tree.bbox(child, f"#{i+1}")
                        if b:
                            bx_list.append(b[0] - 1)
                    if len(bx_list) == len(columns) - 1:
                        return bx_list
        x = 0
        result = []
        for col_id in columns[:-1]:
            x += tree.column(col_id, "width")
            result.append(x - 1)
        return result

    def _get_hdr_h():
        """Tinggi header dalam pixel — cari batas baris pertama."""
        children = tree.get_children("")
        if children:
            b0 = tree.bbox(children[0], "#1")
            if b0 and len(b0) >= 2 and b0[1] > 0:
                return b0[1]
        for y in range(15, 60):
            reg = tree.identify_region(2, y)
            if reg not in ("heading", "separator"):
                return y
        return 24

    def update_lines(event=None):
        try:
            if not tree.winfo_exists():
                return
            tree_w = tree.winfo_width()
            if tree_w <= 10:
                tree.after(50, update_lines)
                return

            boundaries = _get_boundaries()
            hdr_h = _get_hdr_h()

            # Garis vertikal — mulai tepat di bawah header (y=hdr_h) sejajar 100% dengan separator header
            for i, bx in enumerate(boundaries):
                v_lines[i].place(x=bx, y=hdr_h, height=-hdr_h, relheight=1.0, width=1)

            # Garis horizontal tepat di bawah header
            h_line.place(x=0, y=hdr_h, relwidth=1.0, height=1)

            # Hilangkan border di tepi paling kanan header kolom terakhir
            right_cover.place(x=tree_w - 8, y=0, width=9, height=hdr_h)
        except Exception:
            pass

    def on_configure(event=None):
        tree.after_idle(update_lines)

    tree.bind("<Configure>", on_configure, add="+")
    tree.bind("<Map>", lambda e: tree.after_idle(update_lines), add="+")
    tree.bind("<B1-Motion>", lambda e: tree.after_idle(update_lines), add="+")
    tree.bind("<ButtonRelease-1>", lambda e: tree.after_idle(update_lines), add="+")

    # Jadwalkan di beberapa titik waktu agar terpasang sejak pertama kali tampil
    tree.after_idle(update_lines)
    tree.after(50, update_lines)
    tree.after(200, update_lines)
    tree.after(500, update_lines)
    return update_lines


def setup_tree_sorting(tree, base_headers):
    """
    Mengaktifkan fitur klik header kolom untuk sorting (Ascending / Descending)
    dengan penanda panah ▲ / ▼ dan penyesuaian warna baris alternating.
    base_headers: dict mapping col_id -> string judul kolom asli.
    """
    state = {"col": None, "reverse": False}
    tree._sort_state = state

    def sort_by(col_id):
        if state["col"] == col_id:
            is_reverse = not state["reverse"]
        else:
            is_reverse = False

        def parse_val(v):
            if v is None:
                return (3, "")
            s = str(v).strip()
            # Dukung pengurutan kronologis benar untuk tanggal format DD-MM-YYYY
            parts = s.split("-")
            if len(parts) == 3 and len(parts[0]) == 2 and len(parts[2]) == 4:
                try:
                    return (0, int(parts[2]), int(parts[1]), int(parts[0]))
                except ValueError:
                    pass
            # Dukung persentase (mis. "4.2%")
            if s.endswith("%"):
                try:
                    return (1, float(s[:-1].replace(",", ".").strip()))
                except ValueError:
                    pass
            # Dukung mata uang Rupiah (mis. "Rp 35.000") & angka bertitik
            clean = s.replace("Rp", "").replace("rp", "").replace(" ", "").replace(".", "").replace(",", "")
            try:
                return (1, float(clean))
            except ValueError:
                return (2, s.lower())

        items = [(parse_val(tree.set(k, col_id)), k) for k in tree.get_children("")]
        items.sort(key=lambda t: t[0], reverse=is_reverse)

        for idx, (_, k) in enumerate(items):
            tree.move(k, "", idx)
            tag = "odd" if idx % 2 != 0 else "even"
            old_tags = [t for t in tree.item(k, "tags") if t not in ("odd", "even")]
            tree.item(k, tags=(tag, *old_tags))

        state["col"] = col_id
        state["reverse"] = is_reverse
        arrow = " ▼" if is_reverse else " ▲"
        for c, title in base_headers.items():
            if c == col_id:
                tree.heading(c, text=title + arrow)
            else:
                tree.heading(c, text=title)
        tree.event_generate("<Configure>")

    for c in base_headers:
        tree.heading(c, command=lambda _c=c: sort_by(_c))
    return sort_by


# ============================================================
#  KOMPONEN TOMBOL MODERN LINTAS PLATFORM (WINDOWS & MACOS)
# ============================================================
BTN_THEMES = {
    "primary":   {"bg": "#2563eb", "hover": "#1d4ed8", "active": "#1e40af", "fg": "#ffffff", "border": "#1d4ed8"},
    "success":   {"bg": "#16a34a", "hover": "#15803d", "active": "#166534", "fg": "#ffffff", "border": "#15803d"},
    "warning":   {"bg": "#f59e0b", "hover": "#d97706", "active": "#b45309", "fg": "#ffffff", "border": "#d97706"},
    "danger":    {"bg": "#dc2626", "hover": "#b91c1c", "active": "#991b1b", "fg": "#ffffff", "border": "#b91c1c"},
    "indigo":    {"bg": "#eef2ff", "hover": "#e0e7ff", "active": "#c7d2fe", "fg": "#3730a3", "border": "#c7d2fe"},
    "soft_blue": {"bg": "#eff6ff", "hover": "#dbeafe", "active": "#bfdbfe", "fg": "#1d4ed8", "border": "#bfdbfe"},
    "soft_amber":{"bg": "#fffbeb", "hover": "#fef3c7", "active": "#fde68a", "fg": "#b45309", "border": "#fcd34d"},
    "soft_red":  {"bg": "#fef2f2", "hover": "#fee2e2", "active": "#fecaca", "fg": "#b91c1c", "border": "#fecaca"},
    "secondary": {"bg": "#ffffff", "hover": "#f1f5f9", "active": "#e2e8f0", "fg": "#1e293b", "border": "#cbd5e1"},
    "dark":      {"bg": "#334155", "hover": "#475569", "active": "#1e293b", "fg": "#f8fafc", "border": "#475569"},
}
BTN_DISABLED = {"bg": "#e2e8f0", "fg": "#94a3b8", "border": "#cbd5e1"}

# Tinggi standar tombol agar seluruh tombol seragam & rapi di Windows & macOS
BTN_H = 30


class ModernButton(tk.Frame):
    """
    Tombol modern 1px border tanpa ikon dengan warna, efek hover, dan ukuran
    seragam yang konsisten di Windows dan macOS.
    """
    def __init__(self, parent, text="", command=None, variant="secondary",
                 px_width=None, px_height=BTN_H, padx=12, pady=0, state="normal", font=None):
        self._variant = variant if variant in BTN_THEMES else "secondary"
        self._command = command
        self._state = state
        self._hovered = False
        self._pressed = False
        self._text = text
        self._font = font or (FONT_BOLD if self._variant in ("primary", "success", "warning", "danger") else FONT)

        theme = BTN_THEMES[self._variant] if state == "normal" else BTN_DISABLED
        frame_kw = {"bg": theme["border"], "bd": 0, "highlightthickness": 0, "takefocus": 1}
        if px_height is not None:
            frame_kw["height"] = px_height
        if px_width is not None:
            frame_kw["width"] = px_width
        super().__init__(parent, **frame_kw)
        if px_width is not None or px_height is not None:
            self.pack_propagate(False)

        self._lbl = tk.Label(
            self,
            text=text,
            bg=theme["bg"],
            fg=theme["fg"],
            font=self._font,
            padx=padx if px_width is None else 4,
            pady=pady,
            anchor="center",
            cursor="hand2" if state == "normal" else "",
        )
        self._lbl.pack(fill="both", expand=True, padx=1, pady=1)

        for w in (self, self._lbl):
            w.bind("<Enter>", self._on_enter)
            w.bind("<Leave>", self._on_leave)
            w.bind("<ButtonPress-1>", self._on_press)
            w.bind("<ButtonRelease-1>", self._on_release)
        self.bind("<Return>", self._on_key)
        self.bind("<space>", self._on_key)

    def _refresh_colors(self):
        try:
            if not self.winfo_exists():
                return
            if self._state == "disabled":
                super().configure(bg=BTN_DISABLED["border"])
                self._lbl.configure(bg=BTN_DISABLED["bg"], fg=BTN_DISABLED["fg"], cursor="")
                return
            t = BTN_THEMES.get(self._variant, BTN_THEMES["secondary"])
            bg = t["active"] if self._pressed else (t["hover"] if self._hovered else t["bg"])
            super().configure(bg=t["border"])
            self._lbl.configure(bg=bg, fg=t["fg"], cursor="hand2")
        except Exception:
            pass

    def _on_enter(self, e=None):
        self._hovered = True
        self._refresh_colors()

    def _on_leave(self, e=None):
        self._hovered = False
        self._pressed = False
        self._refresh_colors()

    def _on_press(self, e=None):
        if self._state != "normal":
            return
        self._pressed = True
        self._refresh_colors()

    def _on_release(self, e=None):
        if self._state != "normal":
            return
        was_pressed = self._pressed
        self._pressed = False
        inside = False
        try:
            if self.winfo_exists() and e is not None:
                rx, ry = e.x_root, e.y_root
                x0, y0 = self.winfo_rootx(), self.winfo_rooty()
                inside = (x0 <= rx <= x0 + self.winfo_width()) and (y0 <= ry <= y0 + self.winfo_height())
            else:
                inside = True
        except Exception:
            inside = False
        self._refresh_colors()
        if was_pressed and inside and callable(self._command):
            try:
                self._command()
            except Exception:
                pass

    def _on_key(self, e=None):
        if self._state == "normal" and callable(self._command):
            try:
                self._command()
            except Exception:
                pass

    def configure(self, cnf=None, **kw):
        if isinstance(cnf, dict):
            kw = {**cnf, **kw}
        if "text" in kw:
            self._text = kw.pop("text")
            try:
                self._lbl.configure(text=self._text)
            except Exception:
                pass
        if "state" in kw:
            self._state = kw.pop("state")
            if self._state == "disabled":
                self._hovered = False
                self._pressed = False
            self._refresh_colors()
        if "variant" in kw:
            v = kw.pop("variant")
            if v in BTN_THEMES:
                self._variant = v
                self._font = FONT_BOLD if v in ("primary", "success", "warning", "danger") else FONT
                try:
                    self._lbl.configure(font=self._font)
                except Exception:
                    pass
                self._refresh_colors()
        if "command" in kw:
            self._command = kw.pop("command")
        if "px_width" in kw:
            try:
                super().configure(width=kw.pop("px_width"))
                self.pack_propagate(False)
            except Exception:
                pass
        if kw:
            try:
                super().configure(**kw)
            except Exception:
                pass

    config = configure

    def cget(self, key):
        if key == "text":
            return self._text
        if key == "state":
            return self._state
        return super().cget(key)


class PlaceholderVar(tk.StringVar):
    """
    StringVar cerdas dengan teks placeholder native:
    - Ditampilkan langsung oleh text engine ttk.Entry (tanpa widget Label overlay).
    - Tidak menutupi atau merusak border/padding textbox, sehingga tampilan 100% menyatu dan rapi.
    - Saat placeholder aktif, .get() otomatis mengembalikan "" (string kosong) agar validasi form,
      auto-save, dan perhitungan Net Kreator tetap bersih.
    - Untuk password, placeholder tampil terbaca jelas tanpa titik-titik (show="").
    - Saat pengguna mengetik, font otomatis berwarna normal dan password disamarkan.
    """
    def __init__(self, master=None, value="", placeholder="", **kw):
        self.placeholder = placeholder
        self._is_active = False
        self._entry_ref = None
        self._is_password = False
        self._on_click_action = None
        super().__init__(master, value="", **kw)
        if value:
            self.set(value)
        else:
            self.set("")

    def get(self):
        if self._is_active:
            return ""
        val = super().get()
        if val == self.placeholder:
            return ""
        return val

    def set(self, value):
        s_val = str(value or "")
        if not s_val.strip():
            self._is_active = True
            super().set(self.placeholder)
        else:
            self._is_active = False
            super().set(s_val)
        self._update_entry_style()

    def bind_entry(self, entry, is_password=False, on_click_action=None):
        self._entry_ref = entry
        self._is_password = is_password
        self._on_click_action = on_click_action
        self._update_entry_style()

        def _on_focus_in(e=None):
            if self._is_active:
                self._is_active = False
                super(PlaceholderVar, self).set("")
                self._update_entry_style()
                try:
                    entry.icursor(0)
                except Exception:
                    pass

        def _on_focus_out(e=None):
            raw = super(PlaceholderVar, self).get()
            if not raw.strip():
                self.set("")

        def _on_click(e=None):
            if self._on_click_action:
                self._on_click_action()

        entry.bind("<FocusIn>", _on_focus_in, add="+")
        entry.bind("<FocusOut>", _on_focus_out, add="+")
        if on_click_action:
            entry.bind("<Button-1>", _on_click, add="+")

    def _update_entry_style(self):
        if not self._entry_ref:
            return
        e = self._entry_ref
        try:
            if self._is_active:
                e.configure(foreground="#94a3b8")
                if self._is_password:
                    e.configure(show="")
            else:
                e.configure(foreground="#0f172a")
                if self._is_password:
                    is_shown = getattr(e, "_pwd_shown", False)
                    e.configure(show="" if is_shown else "\u2022")
        except Exception:
            pass


def setup_text_placeholder(txt, placeholder_text):
    """
    Placeholder native langsung di dalam tk.Text (Textarea):
    - Menggunakan tag internal tk.Text foreground="#94a3b8" (bukan widget overlay).
    - Padding, baris, font, dan margin 100% presisi dan menyatu dengan text area.
    - Saat placeholder tampil, .get('1.0', 'end-1c') otomatis mengembalikan "" (string kosong).
    """
    txt.tag_configure("placeholder", foreground="#94a3b8")

    orig_get = txt.get
    orig_delete = txt.delete
    orig_insert = txt.insert

    def _is_placeholder():
        try:
            return orig_get("1.0", "end-1c") == placeholder_text
        except Exception:
            return False

    def _show():
        try:
            raw = orig_get("1.0", "end-1c")
            if not raw.strip():
                orig_delete("1.0", "end")
                orig_insert("1.0", placeholder_text, "placeholder")
        except Exception:
            pass

    def _hide():
        try:
            if _is_placeholder():
                orig_delete("1.0", "end")
        except Exception:
            pass

    def _on_focus_in(e=None):
        _hide()

    def _on_focus_out(e=None):
        try:
            raw = orig_get("1.0", "end-1c")
            if not raw.strip():
                _show()
        except Exception:
            pass

    txt.bind("<FocusIn>", _on_focus_in, add="+")
    txt.bind("<FocusOut>", _on_focus_out, add="+")

    def custom_get(*args, **kwargs):
        res = orig_get(*args, **kwargs)
        if res.strip() == placeholder_text.strip():
            return ""
        return res

    txt.get = custom_get
    _show()
    return _show


# ============================================================
#  KOMPONEN PREVIEW GAMBAR & ZOOM (LINTAS PLATFORM)
# ============================================================
def _extract_preview_url(item):
    """Ambil URL preview/thumbnail foto dari objek creation API Fotoyu."""
    if not isinstance(item, dict):
        return ""
    for field in ("image_url", "preview_url", "url", "file_url", "original_url", "thumbnail_url", "thumbnail", "src"):
        v = item.get(field)
        if isinstance(v, str) and v.startswith("http"):
            return v
        if isinstance(v, dict):
            for sub in ("url", "link", "src"):
                sv = v.get(sub)
                if isinstance(sv, str) and sv.startswith("http"):
                    return sv
    return ""


def _pil_to_tk_photo(pil_img):
    """Konversi PIL.Image ke Tk PhotoImage (aman lintas platform Windows & macOS)."""
    if ImageTk is not None:
        try:
            return ImageTk.PhotoImage(pil_img)
        except Exception:
            pass
    buf = io.BytesIO()
    pil_img.save(buf, format="PNG")
    return tk.PhotoImage(data=base64.b64encode(buf.getvalue()).decode("ascii"))


class ImageZoomWindow(tk.Toplevel):
    """Popup zoom gambar preview ukuran besar dengan skema warna senada UI modern (Light Theme)."""
    def __init__(self, parent, title, meta_text, pil_img):
        super().__init__(parent)
        self._pil_img = pil_img
        self._photo = None
        self._resize_job = None
        self._closed = False

        self.title(f"Zoom Preview - {title}")
        self.transient(parent)
        self.configure(bg="#ffffff")

        sw = self.winfo_screenwidth()
        sh = self.winfo_screenheight()
        target_w = min(int(sw * 0.82), 1120)
        target_h = min(int(sh * 0.82), 780)
        self.minsize(480, 360)

        # Header Frame (senada dengan jendela utama & rincian foto)
        top = tk.Frame(self, bg="#ffffff", padx=14, pady=10)
        top.pack(fill="x")
        tk.Label(top, text=title, bg="#ffffff", fg="#0f172a", font=FONT_BOLD, anchor="w").pack(side="left")
        if meta_text:
            tk.Label(top, text=f"  •  {meta_text}", bg="#ffffff", fg="#64748b", font=FONT_SM, anchor="w").pack(side="left")
        ModernButton(top, text="Tutup (Esc)", variant="secondary", px_width=104, command=self._on_close).pack(side="right")

        # Garis pemisah header 1px (#e2e8f0)
        tk.Frame(self, height=1, bg="#e2e8f0", bd=0, highlightthickness=0).pack(fill="x")

        # Footer Frame di-pack side="bottom" SEBELUM area kanvas
        bot = tk.Frame(self, bg="#ffffff", padx=14, pady=8)
        bot.pack(side="bottom", fill="x")
        tk.Frame(self, height=1, bg="#e2e8f0", bd=0, highlightthickness=0).pack(side="bottom", fill="x")
        tk.Label(
            bot,
            text="Tips: Klik dua kali gambar atau tekan Esc untuk menutup zoom preview.",
            bg="#ffffff",
            fg="#94a3b8",
            font=FONT_SM,
        ).pack(side="left")

        # Area Kanvas Gambar (latar bersih #f8fafc dengan border 1px #e2e8f0)
        outer_box = tk.Frame(self, bg="#ffffff", padx=12, pady=12)
        outer_box.pack(fill="both", expand=True)

        self.canvas_box = tk.Frame(outer_box, bg="#f8fafc", bd=0, highlightthickness=1, highlightbackground="#e2e8f0")
        self.canvas_box.pack(fill="both", expand=True)
        self.canvas_box.pack_propagate(False)

        self.lbl_img = tk.Label(self.canvas_box, bg="#f8fafc", cursor="hand2")
        self.lbl_img.pack(fill="both", expand=True)
        self.lbl_img.bind("<Double-1>", lambda e: self._on_close())
        self.canvas_box.bind("<Configure>", self._on_resize)
        self.bind("<Escape>", lambda e: self._on_close())

        center_popup(self, parent, default_w=target_w, default_h=target_h)
        bring_to_front(self, parent)
        self.protocol("WM_DELETE_WINDOW", self._on_close)
        try:
            self.grab_set()
        except Exception:
            pass
        self.after(40, self._render)

    def _on_close(self):
        self._closed = True
        if self._resize_job:
            try:
                self.after_cancel(self._resize_job)
            except Exception:
                pass
            self._resize_job = None
        try:
            self.destroy()
        except Exception:
            pass

    def _on_resize(self, event=None):
        if self._closed:
            return
        if self._resize_job:
            try:
                self.after_cancel(self._resize_job)
            except Exception:
                pass
        self._resize_job = self.after(70, self._render)

    def _render(self):
        if self._closed or self._pil_img is None:
            return
        try:
            w = max(self.canvas_box.winfo_width() - 16, 240)
            h = max(self.canvas_box.winfo_height() - 16, 200)
            img = self._pil_img.copy()
            img.thumbnail((w, h), Image.Resampling.LANCZOS)
            self._photo = _pil_to_tk_photo(img)
            self.lbl_img.configure(image=self._photo)
        except Exception:
            pass


class ImagePreviewPanel:
    """
    Panel kartu Image Preview 1px border (#e2e8f0) yang tingginya & garis headernya
    sejajar presisi dengan Treeview di sampingnya (identik di Windows & macOS).
    Mendukung unduh asinkron, cache memori, klik gambar untuk Zoom, serta mode compact_meta.
    """
    def __init__(self, parent_container, owner_win, tree, api=None, complete_dir="", width=320, compact_meta=False):
        self.owner_win = owner_win
        self.tree = tree
        self.api = api
        self.complete_dir = complete_dir or COMPLETE_DIR
        self.compact_meta = compact_meta
        self._closed = False
        self.ui_queue = queue.Queue()
        self._img_cache = {}
        self._preview_req_id = 0
        self._current_pil_img = None
        self._current_title = "-"
        self._current_meta = ""
        self._preview_photo = None
        self._resize_job = None
        self._poll_job = None

        # Wrapper 1px border (#e2e8f0) — konsisten di Windows & macOS
        self.preview_border = tk.Frame(parent_container, width=width, bg="#e2e8f0", bd=0, highlightthickness=0)
        self.preview_border.pack(side="right", fill="y", padx=(12, 0))
        self.preview_border.pack_propagate(False)

        preview_outer = tk.Frame(self.preview_border, bg="#ffffff", bd=0, highlightthickness=0)
        preview_outer.pack(fill="both", expand=True, padx=1, pady=1)

        # Header panel sejajar dengan header tabel
        self._prev_hdr = tk.Frame(preview_outer, bg="#ffffff", height=24, bd=0, highlightthickness=0)
        self._prev_hdr.pack(fill="x")
        self._prev_hdr.pack_propagate(False)
        tk.Label(
            self._prev_hdr,
            text="Image Preview",
            bg="#ffffff",
            fg="#0f172a",
            font=FONT_BOLD,
            anchor="center",
        ).pack(fill="both", expand=True)
        tk.Frame(preview_outer, height=1, bg="#e2e8f0", bd=0, highlightthickness=0).pack(fill="x")

        # Metadata foto di bagian bawah kartu — di-pack side="bottom" SEBELUM preview_box agar posisi terkunci rapi di bawah
        meta_outer = tk.Frame(preview_outer, bg="#ffffff", bd=0, highlightthickness=0)
        meta_outer.pack(side="bottom", fill="x")
        tk.Frame(meta_outer, height=1, bg="#e2e8f0", bd=0, highlightthickness=0).pack(fill="x")

        meta_frame = tk.Frame(meta_outer, bg="#ffffff", padx=8, pady=6, bd=0, highlightthickness=0)
        meta_frame.pack(fill="x")

        self.v_prev_title = tk.StringVar(value="-")
        self.v_prev_meta = tk.StringVar(value="-" if self.compact_meta else "Pilih foto pada tabel di samping")
        self.v_prev_hint = tk.StringVar(value="")

        if not self.compact_meta:
            self.lbl_title = tk.Label(
                meta_frame,
                textvariable=self.v_prev_title,
                bg="#ffffff",
                fg="#0f172a",
                font=FONT_BOLD,
                anchor="center",
                justify="center",
                wraplength=width - 24,
            )
            self.lbl_title.pack(fill="x")

        self.lbl_meta = tk.Label(
            meta_frame,
            textvariable=self.v_prev_meta,
            bg="#ffffff",
            fg="#64748b",
            font=FONT_SM,
            anchor="center",
            justify="center",
            wraplength=width - 24,
        )
        self.lbl_meta.pack(fill="x", pady=(2 if not self.compact_meta else 0, 0))

        self.lbl_hint = tk.Label(
            meta_frame,
            textvariable=self.v_prev_hint,
            bg="#ffffff",
            fg="#2563eb",
            font=(FONT_NAME, 8),
            anchor="center",
            justify="center",
        )
        self.lbl_hint.pack(fill="x", pady=(2, 0))

        # Area gambar — di-pack fill="both", expand=True mengisi ruang tengah kartu
        self.preview_box = tk.Frame(preview_outer, bg="#f8fafc", bd=0, highlightthickness=0)
        self.preview_box.pack(fill="both", expand=True, padx=8, pady=(8, 6))
        self.preview_box.pack_propagate(False)

        self.lbl_preview = tk.Label(
            self.preview_box,
            text="Klik salah satu baris foto\nuntuk melihat preview",
            bg="#f8fafc",
            fg="#64748b",
            font=FONT_SM,
            justify="center",
            compound="center",
        )
        self.lbl_preview.pack(fill="both", expand=True, padx=4, pady=4)
        self.lbl_preview.bind("<Button-1>", self._on_click_zoom)
        self.preview_box.bind("<Configure>", self._on_preview_resize)

        # Sinkronisasi tinggi header dengan Treeview
        if tree is not None:
            tree.bind("<Configure>", lambda e: self._schedule_hdr_sync(), add="+")
        self.owner_win.after(60, self._sync_preview_hdr)
        self.owner_win.after(220, self._sync_preview_hdr)
        self._poll_job = self.owner_win.after(50, self._poll_queue)

    def _schedule_hdr_sync(self):
        if not self._closed:
            try:
                self.owner_win.after_idle(self._sync_preview_hdr)
            except Exception:
                pass

    def _sync_preview_hdr(self):
        if self._closed or not self.tree:
            return
        try:
            hdr_h = None
            children = self.tree.get_children("")
            if children:
                b0 = self.tree.bbox(children[0], "#1")
                if b0 and len(b0) >= 2 and b0[1] > 0:
                    hdr_h = b0[1]
            if not hdr_h:
                for y in range(15, 60):
                    if self.tree.identify_region(2, y) not in ("heading", "separator"):
                        hdr_h = y
                        break
            if hdr_h and hdr_h >= 18:
                self._prev_hdr.configure(height=max(18, hdr_h - 1))
        except Exception:
            pass

    def close(self):
        self._closed = True
        for attr in ("_resize_job", "_poll_job"):
            job = getattr(self, attr, None)
            if job:
                try:
                    self.owner_win.after_cancel(job)
                except Exception:
                    pass
                setattr(self, attr, None)

    def _poll_queue(self):
        self._poll_job = None
        if self._closed:
            return
        try:
            while True:
                fn = self.ui_queue.get_nowait()
                try:
                    fn()
                except Exception:
                    pass
        except queue.Empty:
            pass
        if not self._closed:
            try:
                self._poll_job = self.owner_win.after(60, self._poll_queue)
            except Exception:
                pass

    def clear(self, msg="Klik salah satu baris foto\nuntuk melihat preview"):
        self._preview_req_id += 1
        self._current_pil_img = None
        self._preview_photo = None
        self.v_prev_title.set("-" if not self.compact_meta else "")
        self.v_prev_meta.set("-" if self.compact_meta else "Pilih foto pada tabel di samping")
        self.v_prev_hint.set("")
        self.lbl_preview.configure(image="", text=msg, cursor="")

    def show_item(self, it):
        if self._closed or not isinstance(it, dict):
            return
        title = it.get("title") or it.get("content_id") or "Foto"
        res = it.get("resolution") if isinstance(it.get("resolution"), dict) else {}
        rw, rh = res.get("width"), res.get("height")
        fsize = it.get("size") or 0

        dim_str = f"{rw}×{rh} px" if (rw and rh) else ""
        fmt_size = ""
        if fsize:
            fmt_size = f"{fsize / 1024:.0f} KB"

        if self.compact_meta:
            # Mode compact (Rincian Foto & Riwayat Foto Terjual): cukup px dan KB saja karena info lain sudah ada di tabel
            meta_parts = []
            if dim_str:
                meta_parts.append(dim_str)
            if fmt_size:
                meta_parts.append(fmt_size)
            meta_str = "  •  ".join(meta_parts) if meta_parts else "-"
            self._current_title = title
            self._current_meta = meta_str
            self.v_prev_title.set("")
            self.v_prev_meta.set(meta_str)
        else:
            is_sold = it.get("purchase_status") == "sold"
            status_txt = "Terjual" if is_sold else "Tersedia"
            meta_parts = []
            if dim_str:
                meta_parts.append(dim_str)
            if fmt_size:
                meta_parts.append(fmt_size)
            fototree = it.get("fototree") or extract_fototree_name(it)
            if fototree and fototree != "-":
                meta_parts.append(f"Tree: {fototree}")
            meta_parts.append(status_txt)
            if is_sold:
                price_val = it.get("price")
                net_val = it.get("net_price")
                if price_val:
                    if net_val:
                        meta_parts.append(f"Net: {format_idr(net_val)}")
                    else:
                        meta_parts.append(f"Harga: {format_idr(price_val)}")
            meta_str = "  |  ".join(meta_parts)
            self._current_title = title
            self._current_meta = meta_str
            self.v_prev_title.set(title)
            self.v_prev_meta.set(meta_str)

        url = _extract_preview_url(it)
        local_path = ""
        if not url and title and self.complete_dir:
            cand = os.path.join(self.complete_dir, title)
            if os.path.isfile(cand):
                local_path = cand

        cache_key = url or local_path
        if not cache_key:
            self._preview_req_id += 1
            self._current_pil_img = None
            self._preview_photo = None
            self.v_prev_hint.set("")
            self.lbl_preview.configure(image="", text="Preview tidak tersedia\nuntuk foto ini", cursor="")
            return

        if cache_key in self._img_cache:
            self._preview_req_id += 1
            self._current_pil_img = self._img_cache[cache_key]
            self._render_current_image()
            return

        self._preview_req_id += 1
        req_id = self._preview_req_id
        self._current_pil_img = None
        self._preview_photo = None
        self.v_prev_hint.set("")
        self.lbl_preview.configure(image="", text="Memuat preview...", cursor="")

        threading.Thread(
            target=self._load_preview_worker,
            args=(req_id, url, local_path, cache_key),
            daemon=True,
        ).start()

    def _load_preview_worker(self, req_id, url, local_path, cache_key):
        try:
            pil_img = None
            if url:
                headers = {
                    "User-Agent": HEADERS_BASE["User-Agent"],
                    "Referer": "https://www.fotoyu.com/",
                    "Accept": "image/avif,image/webp,image/apng,image/*,*/*;q=0.8",
                }
                sess = self.api.session if (self.api is not None and hasattr(self.api, "session")) else requests
                with sess.get(url, headers=headers, timeout=15) as r:
                    if r.status_code == 200 and r.content:
                        with Image.open(io.BytesIO(r.content)) as im:
                            try:
                                im = ImageOps.exif_transpose(im)
                            except Exception:
                                pass
                            im = flatten_alpha(im)
                            im.thumbnail((1280, 1280), Image.Resampling.LANCZOS)
                            pil_img = im.copy()
            elif local_path and os.path.isfile(local_path):
                with Image.open(local_path) as im:
                    try:
                        im = ImageOps.exif_transpose(im)
                    except Exception:
                        pass
                    im = flatten_alpha(im)
                    im.thumbnail((1280, 1280), Image.Resampling.LANCZOS)
                    pil_img = im.copy()

            if self._closed:
                return
            if pil_img is not None:
                self.ui_queue.put(lambda rid=req_id, ck=cache_key, img=pil_img: self._on_preview_loaded(rid, ck, img))
            else:
                self.ui_queue.put(lambda rid=req_id: self._on_preview_error(rid, "Gagal memuat gambar preview"))
        except Exception:
            if not self._closed:
                self.ui_queue.put(lambda rid=req_id: self._on_preview_error(rid, "Gagal memuat gambar preview"))

    def _on_preview_loaded(self, req_id, cache_key, pil_img):
        if self._closed:
            return
        if len(self._img_cache) >= 50:
            try:
                oldest = next(iter(self._img_cache))
                del self._img_cache[oldest]
            except Exception:
                pass
        self._img_cache[cache_key] = pil_img
        if req_id != self._preview_req_id:
            return
        self._current_pil_img = pil_img
        self._render_current_image()

    def _on_preview_error(self, req_id, msg):
        if self._closed or req_id != self._preview_req_id:
            return
        self._current_pil_img = None
        self._preview_photo = None
        self.v_prev_hint.set("")
        self.lbl_preview.configure(image="", text=msg, cursor="")

    def _on_preview_resize(self, event=None):
        if self._closed or self._current_pil_img is None:
            return
        if self._resize_job:
            try:
                self.owner_win.after_cancel(self._resize_job)
            except Exception:
                pass
        self._resize_job = self.owner_win.after(80, self._render_current_image)

    def _render_current_image(self):
        if self._closed or self._current_pil_img is None:
            return
        try:
            box_w = max(self.preview_box.winfo_width() - 16, 120)
            box_h = max(self.preview_box.winfo_height() - 16, 120)
            img = self._current_pil_img.copy()
            img.thumbnail((box_w, box_h), Image.Resampling.LANCZOS)
            photo = _pil_to_tk_photo(img)
            self._preview_photo = photo
            self.lbl_preview.configure(image=photo, text="", cursor="hand2")
            self.v_prev_hint.set("Klik gambar untuk perbesar")
        except Exception:
            self.v_prev_hint.set("")
            self.lbl_preview.configure(image="", text="Gagal menampilkan gambar", cursor="")

    def _on_click_zoom(self, event=None):
        if self._closed or self._current_pil_img is None:
            return
        ImageZoomWindow(self.owner_win, self._current_title, self._current_meta, self._current_pil_img)


# ============================================================
#  WINDOW: RINCIAN FOTO TANGGAL (DETAIL + FILTER + IMAGE PREVIEW)
# ============================================================
class PhotoDetailWindow(tk.Toplevel):
    def __init__(self, parent, date_str, creations, api=None, complete_dir="", default_price=35000, net_earning_fn=None):
        super().__init__(parent)
        self.api = api
        self.all_creations = list(creations or [])
        self._closed = False
        self._item_map = {}
        self.default_price = default_price
        self.net_earning_fn = net_earning_fn

        disp_date = format_display_date(date_str)
        self.disp_date = disp_date
        self.title(f"Rincian Foto - Tanggal {disp_date} ({len(self.all_creations)} foto)")
        self.minsize(980, 480)
        self.transient(parent)

        main = ttk.Frame(self, padding=12)
        main.pack(fill="both", expand=True)

        # Header
        hdr = ttk.Frame(main)
        hdr.pack(fill="x", pady=(0, 8))
        hdr_left = ttk.Frame(hdr)
        hdr_left.pack(side="left", fill="x", expand=True)
        ttk.Label(hdr_left, text=f"Rincian Foto: Tanggal {disp_date}", font=FONT_TITLE, foreground="#0f172a").pack(anchor="w")
        self.v_subtitle = tk.StringVar(value=f"Total: {len(self.all_creations)} file foto  |  Deteksi Akurasi, Wajah & Status AI Robofind")
        ttk.Label(hdr_left, textvariable=self.v_subtitle, font=FONT_SM, foreground="#64748b").pack(anchor="w")
        ModernButton(hdr, text="Ekspor CSV", variant="soft_blue", px_width=106, command=self.on_export_csv).pack(side="right")

        # ---- Footer di-pack side="bottom" SEBELUM body agar tombol Tutup tidak pernah mengecil ----
        bot = ttk.Frame(main)
        bot.pack(side="bottom", fill="x", pady=(10, 0))
        ttk.Label(
            bot,
            text="Tips: Klik baris foto (atau panah atas/bawah) untuk preview. Klik gambar preview untuk zoom.",
            font=FONT_SM,
            foreground="#64748b",
        ).pack(side="left")
        self.btn_close = ModernButton(bot, text="Tutup", variant="secondary", px_width=90, command=self._on_close)
        self.btn_close.pack(side="right")

        # Bar Filter & Pencarian (ditempatkan di atas body, elemen pack ke kiri rapi tidak melebihi lebar tabel)
        fbar = ttk.Frame(main)
        fbar.pack(fill="x", pady=(0, 6))
        ttk.Label(fbar, text="Cari:", font=FONT_SM, foreground="#334155").pack(side="left", padx=(0, 3))
        self.v_search = PlaceholderVar(fbar, placeholder="Cari foto...")
        ent_search = ttk.Entry(fbar, textvariable=self.v_search, width=14)
        ent_search.pack(side="left", padx=(0, 6))
        self.v_search.bind_entry(ent_search)
        self.v_search.trace_add("write", lambda *a: self._apply_filter())

        ttk.Label(fbar, text="Filter:", font=FONT_SM, foreground="#334155").pack(side="left", padx=(0, 3))
        self.v_filter = tk.StringVar(value="Semua")
        cb_filter = ttk.Combobox(
            fbar,
            textvariable=self.v_filter,
            values=[
                "Semua",
                "Terjual",
                "Tersedia",
                "Ada Konfirm (>0)",
                "Akurasi 5+ (>0)",
                "Tanpa Wajah (0)",
                "Robofind Proses",
            ],
            state="readonly",
            width=12,
        )
        cb_filter.pack(side="left", padx=(0, 6))
        cb_filter.bind("<<ComboboxSelected>>", lambda e: self._apply_filter())

        # Kumpulkan fototree unik dari seluruh foto pada tanggal ini
        unique_trees = []
        for it in self.all_creations:
            tname = it.get("fototree") or extract_fototree_name(it)
            if tname and tname not in unique_trees and tname != "-":
                unique_trees.append(tname)
        unique_trees.sort()

        ttk.Label(fbar, text="Fototree:", font=FONT_SM, foreground="#334155").pack(side="left", padx=(0, 3))
        self.v_tree_filter = tk.StringVar(value="Semua")
        self.cb_tree_filter = ttk.Combobox(
            fbar,
            textvariable=self.v_tree_filter,
            values=["Semua"] + unique_trees,
            state="readonly",
            width=13,
        )
        self.cb_tree_filter.pack(side="left", padx=(0, 6))
        self.cb_tree_filter.bind("<<ComboboxSelected>>", lambda e: self._apply_filter())

        # Badge ringkasan Sebelah Filter: xxxx Foto DIJADIKAN SATU dengan Terjual & Est. Pendapatan
        # Tinggi disamakan dengan Combobox (21px), background lembut hijau #f0fdf4, border #86efac, font hijau seragam
        self.v_match_count = tk.StringVar(value=f"{len(self.all_creations)} Foto")
        self.v_sold_stats = tk.StringVar(value="Terjual: 0 Foto")
        self.v_rev_stats = tk.StringVar(value="Est: Rp 0")
        stat_badge = tk.Frame(fbar, bg="#f0fdf4", highlightbackground="#86efac", highlightthickness=1)
        stat_badge.pack(side="left", padx=(2, 6))

        tk.Label(stat_badge, textvariable=self.v_match_count, font=(FONT_NAME, 9, "bold"), fg="#15803d", bg="#f0fdf4", bd=0, padx=6, pady=2).pack(side="left")
        tk.Label(stat_badge, text="|", font=FONT_SM, fg="#86efac", bg="#f0fdf4", bd=0, padx=2, pady=2).pack(side="left")
        tk.Label(stat_badge, textvariable=self.v_sold_stats, font=(FONT_NAME, 9, "bold"), fg="#15803d", bg="#f0fdf4", bd=0, padx=6, pady=2).pack(side="left")
        tk.Label(stat_badge, text="|", font=FONT_SM, fg="#86efac", bg="#f0fdf4", bd=0, padx=2, pady=2).pack(side="left")
        tk.Label(stat_badge, textvariable=self.v_rev_stats, font=(FONT_NAME, 9, "bold"), fg="#047857", bg="#f0fdf4", bd=0, padx=6, pady=2).pack(side="left")

        # Kontainer utama: Tabel (kiri) & Image Preview (kanan) — keduanya anak langsung dari body sehingga tinggi presisi sama
        body = ttk.Frame(main)
        body.pack(fill="both", expand=True)

        # ---- Kiri: Tabel Rincian Foto ----
        tbl_frame = ttk.Frame(body)
        tbl_frame.pack(side="left", fill="both", expand=True)

        cols = ("num", "title", "fototree", "ak_plus", "ak_min", "konfirm", "faces", "robofind", "status")
        tree = ttk.Treeview(tbl_frame, columns=cols, show="headings", selectmode="browse")
        self.tree = tree
        tree.tag_configure("even", background="#ffffff")
        tree.tag_configure("odd", background="#f8fafc")
        tree.tag_configure("sold_row", foreground="#059669")
        tree.tag_configure("proc_row", foreground="#b45309")

        headers = [
            ("num", "#", 38, "center"),
            ("title", "Nama File / Judul", 175, "w"),
            ("fototree", "Fototree", 120, "w"),
            ("ak_plus", "Akurasi 5+", 74, "center"),
            ("ak_min", "Akurasi 5-", 74, "center"),
            ("konfirm", "Konfirm", 66, "center"),
            ("faces", "Wajah", 56, "center"),
            ("robofind", "Robofind", 70, "center"),
            ("status", "Status", 74, "center"),
        ]
        self._base_headers = {}
        for cid, ctext, cw, canchor in headers:
            tree.heading(cid, text=ctext)
            tree.column(cid, width=cw, anchor=canchor)
            self._base_headers[cid] = ctext

        setup_tree_grid_lines(tree, cols)
        setup_tree_sorting(tree, self._base_headers)

        vsb = ttk.Scrollbar(tbl_frame, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=vsb.set)
        tree.pack(side="left", fill="both", expand=True)
        vsb.pack(side="right", fill="y")

        # ---- Kanan: Panel Image Preview (tinggi sama dengan tabel, info ringkas px & KB) ----
        self.preview_panel = ImagePreviewPanel(body, self, tree, api=api, complete_dir=complete_dir, width=320, compact_meta=True)
        # Alias kompatibilitas untuk pengujian/inspeksi internal
        self.preview_border = self.preview_panel.preview_border
        self._prev_hdr = self.preview_panel._prev_hdr
        self.lbl_preview = self.preview_panel.lbl_preview
        self.v_prev_title = self.preview_panel.v_prev_title
        self.v_prev_meta = self.preview_panel.v_prev_meta

        tree.bind("<<TreeviewSelect>>", self._on_select_row)
        self._apply_filter()

        center_popup(self, parent, default_w=1120, default_h=580)
        bring_to_front(self, parent)
        self.protocol("WM_DELETE_WINDOW", self._on_close)
        try:
            self.grab_set()
        except Exception:
            pass

    @property
    def _preview_photo(self):
        return self.preview_panel._preview_photo

    @property
    def _img_cache(self):
        return self.preview_panel._img_cache

    def _on_close(self):
        self._closed = True
        self.preview_panel.close()
        try:
            self.destroy()
        except Exception:
            pass

    def _apply_filter(self):
        q = self.v_search.get().strip().lower()
        flt = self.v_filter.get()
        sel_tree = self.v_tree_filter.get()
        self.tree.delete(*self.tree.get_children(""))
        self._item_map.clear()

        shown = 0
        sold_count = 0
        est_rev = 0.0

        for idx, it in enumerate(self.all_creations, 1):
            tname = it.get("fototree") or extract_fototree_name(it) or "-"
            if sel_tree != "Semua" and tname != sel_tree:
                continue
            title = str(it.get("title") or it.get("content_id") or f"Foto #{idx}")
            if q and q not in title.lower() and q not in tname.lower():
                continue
            is_sold = it.get("purchase_status") == "sold"
            ak_plus = it.get("found_count", 0) or 0
            ak_min = it.get("found_count_low", 0) or 0
            konfirm = it.get("confirmed_count", 0) or 0
            faces = it.get("face_count", 0) or 0
            rf_label = get_robofind_label(it)

            if flt == "Terjual" and not is_sold:
                continue
            if flt == "Tersedia" and is_sold:
                continue
            if flt == "Ada Konfirm (>0)" and konfirm <= 0:
                continue
            if flt == "Akurasi 5+ (>0)" and ak_plus <= 0:
                continue
            if flt == "Tanpa Wajah (0)" and faces > 0:
                continue
            if flt == "Robofind Proses" and rf_label != "Proses":
                continue

            shown += 1
            if is_sold:
                sold_count += 1
                net_val = it.get("net_price")
                if net_val is None:
                    p = it.get("price") or self.default_price
                    tag_id = None
                    if isinstance(it.get("tags"), list) and it["tags"]:
                        tag_id = it["tags"][0].get("id")
                    if callable(self.net_earning_fn):
                        net_val = self.net_earning_fn(p, tag_id)
                    else:
                        net_val = round(p * 0.842)
                    it["net_price"] = net_val
                est_rev += float(net_val or 0.0)

            status_txt = "Terjual" if is_sold else "Tersedia"
            row_tag = "odd" if shown % 2 != 0 else "even"
            tags = [row_tag]
            if is_sold:
                tags.append("sold_row")
            elif rf_label == "Proses":
                tags.append("proc_row")
            iid = self.tree.insert("", "end", values=(
                shown,
                title,
                tname,
                ak_plus,
                ak_min,
                konfirm,
                faces,
                rf_label,
                status_txt,
            ), tags=tuple(tags))
            self._item_map[iid] = it

        self.v_sold_stats.set(f"Terjual: {sold_count:,}".replace(",", ".") + " Foto")
        self.v_rev_stats.set(f"Est: {format_idr(est_rev)}")
        self.v_match_count.set(f"{shown} Foto")
        self.v_subtitle.set(f"Menampilkan {shown} dari {len(self.all_creations)} foto  |  Deteksi Akurasi, Wajah & Status AI Robofind")
        self.tree.event_generate("<Configure>")

    def _on_select_row(self, event=None):
        if self._closed:
            return
        sel = self.tree.selection()
        if not sel:
            return
        it = self._item_map.get(sel[0])
        if it:
            self.preview_panel.show_item(it)

    def on_export_csv(self):
        children = self.tree.get_children("")
        if not children:
            messagebox.showwarning("Ekspor CSV", "Tidak ada baris foto untuk diekspor.", parent=self)
            return
        safe_date = self.disp_date.replace("/", "-")
        default_name = f"fotoyu_rincian_{safe_date}.csv"
        path = filedialog.asksaveasfilename(
            parent=self,
            title="Simpan Rincian Foto CSV",
            initialfile=default_name,
            defaultextension=".csv",
            filetypes=[("CSV Files", "*.csv"), ("All Files", "*.*")],
        )
        if not path:
            return
        try:
            with open(path, "w", newline="", encoding="utf-8-sig") as f:
                writer = csv.writer(f)
                writer.writerow(["#", "Nama File / Judul", "Fototree", "Akurasi 5+", "Akurasi 5-", "Konfirm", "Wajah", "Robofind", "Status"])
                for iid in children:
                    writer.writerow(self.tree.item(iid, "values"))
            messagebox.showinfo("Ekspor Berhasil", f"Rincian foto berhasil disimpan ke:\n{path}", parent=self)
        except Exception as e:
            messagebox.showerror("Ekspor Gagal", f"Gagal mengekspor file: {e}", parent=self)


# ============================================================
#  WINDOW: STATISTIK FOTOYU (PARALEL + FILTER + TAB TERJUAL + STORAGE)
# ============================================================
class StatisticsWindow(tk.Toplevel):
    def __init__(self, parent, api, ensure_token_fn, username, password, default_price=35000, tag_id=None, complete_dir=""):
        super().__init__(parent)
        self.api = api
        self.ensure_token_fn = ensure_token_fn
        self.username = username
        self.password = password
        try:
            self.default_price = int(float(default_price or 35000))
        except Exception:
            self.default_price = 35000
        self.tag_id = tag_id
        self.complete_dir = complete_dir or COMPLETE_DIR

        self.stop_event = threading.Event()
        self.ui_queue = queue.Queue()
        self.creations_by_date = {}
        self.rows_data = []
        self.sold_creations_all = []
        self._sold_item_map = {}
        self._fee_cache = {}
        self._net_unit_price = None
        self._poll_job = None

        self.title(f"Statistik Akun FotoYu - {self.username}")
        self.minsize(880, 560)
        self.transient(parent)

        self._build_ui()
        center_popup(self, parent, default_w=1060, default_h=680)
        bring_to_front(self, parent)
        self.protocol("WM_DELETE_WINDOW", self._on_close)
        self._poll_job = self.after(50, self._poll_queue)
        self.after(100, self.start_fetch)

    def _poll_queue(self):
        self._poll_job = None
        try:
            while True:
                fn = self.ui_queue.get_nowait()
                try:
                    fn()
                except Exception:
                    pass
        except queue.Empty:
            pass
        if not self.stop_event.is_set():
            try:
                self._poll_job = self.after(80, self._poll_queue)
            except Exception:
                pass

    def post(self, fn):
        self.ui_queue.put(fn)

    def get_net_creator_earning(self, price, tag_id=None):
        """Menghitung Net Kreator (harga foto setelah dipotong Biaya FotoYu)."""
        try:
            p = int(float(price or 0))
        except Exception:
            p = 0
        if p <= 0:
            return 0.0
        cache_key = (p, tag_id or "")
        if cache_key in self._fee_cache:
            return self._fee_cache[cache_key]
        try:
            raw = self.api.get_transaction_fee(p, tag_id)
            net, _ = parse_fee_summary(raw, p)
            if net is not None and net > 0:
                self._fee_cache[cache_key] = net
                return net
        except Exception:
            pass
        # Fallback standar FotoYu (15.8% fee platform)
        fee = round(p * 0.158)
        net = max(0.0, float(p - fee))
        self._fee_cache[cache_key] = net
        return net

    def _on_close(self):
        self.stop_event.set()
        if self._poll_job:
            try:
                self.after_cancel(self._poll_job)
            except Exception:
                pass
            self._poll_job = None
        if hasattr(self, "sold_preview"):
            self.sold_preview.close()
        try:
            self.destroy()
        except Exception:
            pass

    def _build_ui(self):
        main = ttk.Frame(self, padding=12)
        main.pack(fill="both", expand=True)

        # Header Frame
        hdr = ttk.Frame(main)
        hdr.pack(fill="x", pady=(0, 10))

        title_frame = ttk.Frame(hdr)
        title_frame.pack(side="left", fill="x", expand=True)
        ttk.Label(title_frame, text="Statistik Foto & Penjualan FotoYu", font=FONT_TITLE, foreground="#0f172a").pack(anchor="w")
        self.v_sub_hdr = tk.StringVar(value=f"Akun: {self.username}  |  Ringkasan Folder, AI Robofind, Penjualan & Net Kreator")
        ttk.Label(title_frame, textvariable=self.v_sub_hdr, font=FONT_SM, foreground="#64748b").pack(anchor="w")

        btn_box = ttk.Frame(hdr)
        btn_box.pack(side="right")

        # Storage Display (Teks ringkas tanpa bar sesuai fotoyustorage.json)
        self.v_storage = tk.StringVar(value="-")
        self.st_badge = tk.Frame(btn_box, bg="#f8fafc", highlightbackground="#e2e8f0", highlightthickness=1, padx=10, pady=5)
        self.st_badge.pack(side="left", padx=(0, 10))
        self.lbl_storage = tk.Label(self.st_badge, textvariable=self.v_storage, bg="#f8fafc", fg="#0284c7", font=(FONT_NAME, 9, "bold"))
        self.lbl_storage.pack()

        self.btn_refresh = ModernButton(btn_box, text="Muat Ulang", variant="primary", px_width=106, command=self.start_fetch)
        self.btn_refresh.pack(side="left", padx=(0, 6))
        self.btn_export = ModernButton(btn_box, text="Ekspor CSV", variant="soft_blue", px_width=106, command=self.on_export_csv)
        self.btn_export.pack(side="left")

        # Summary Metric Cards Frame (Grid 2x4 dengan uniform width & height 100% identik di Windows & macOS)
        # Urutan funnel informatif:
        #   Baris 1 (Alur Upload & Deteksi AI): Total Foto -> Wajah Terdeteksi -> Akurasi 5+ -> Akurasi 5-
        #   Baris 2 (Alur Pembelian & Hasil)  : Konfirm -> Terjual -> Konversi Terjual -> Est. Pendapatan
        cards_grid = ttk.Frame(main)
        cards_grid.pack(fill="x", pady=(0, 8))
        # 4 kolom kartu (0, 2, 4, 6) ukuran identik + 3 kolom spasi 8px (1, 3, 5)
        for col_idx in (0, 2, 4, 6):
            cards_grid.columnconfigure(col_idx, weight=1, uniform="stat_card")
        for gap_idx in (1, 3, 5):
            cards_grid.columnconfigure(gap_idx, minsize=8, weight=0)
        for row_idx in (0, 2):
            cards_grid.rowconfigure(row_idx, weight=1, uniform="stat_row")
        cards_grid.rowconfigure(1, minsize=8, weight=0)

        self.v_tot_foto = tk.StringVar(value="0")
        self.v_tot_faces = tk.StringVar(value="0")
        self.v_tot_ak_plus = tk.StringVar(value="0")
        self.v_tot_ak_min = tk.StringVar(value="0")
        self.v_tot_konfirm = tk.StringVar(value="0")
        self.v_tot_terjual = tk.StringVar(value="0")
        self.v_tot_conv = tk.StringVar(value="0%")
        self.v_tot_rev = tk.StringVar(value="Rp 0")

        FONT_CARD_LBL = (FONT_NAME, 9)
        FONT_CARD_VAL = (FONT_NAME, 15, "bold")
        self._stat_cards = []

        def make_card(row, col, label, tvar, color):
            # Outer border 1px seragam (#e2e8f0) — ukuran 100% identik di Windows & macOS
            card_border = tk.Frame(cards_grid, bg="#e2e8f0", bd=0, highlightthickness=0)
            card_border.grid(row=row * 2, column=col * 2, sticky="nsew")

            card_body = tk.Frame(card_border, bg="#ffffff", bd=0, highlightthickness=0)
            card_body.pack(fill="both", expand=True, padx=1, pady=1)

            # Aksen warna vertikal 3px di sisi kiri kartu
            tk.Frame(card_body, width=3, bg=color, bd=0, highlightthickness=0).pack(side="left", fill="y")

            content = tk.Frame(card_body, bg="#ffffff", padx=10, pady=7, bd=0, highlightthickness=0)
            content.pack(side="left", fill="both", expand=True)

            tk.Label(content, text=label, bg="#ffffff", fg="#64748b", font=FONT_CARD_LBL, anchor="w").pack(fill="x")
            tk.Label(content, textvariable=tvar, bg="#ffffff", fg=color, font=FONT_CARD_VAL, anchor="w").pack(fill="x", pady=(2, 0))
            self._stat_cards.append(card_border)

        # Baris 1: Alur Upload & Deteksi AI
        make_card(0, 0, "Total Foto", self.v_tot_foto, "#2563eb")
        make_card(0, 1, "Wajah Terdeteksi", self.v_tot_faces, "#0284c7")
        make_card(0, 2, "Akurasi 5+", self.v_tot_ak_plus, "#16a34a")
        make_card(0, 3, "Akurasi 5-", self.v_tot_ak_min, "#d97706")

        # Baris 2: Alur Pembelian & Hasil
        make_card(1, 0, "Konfirm", self.v_tot_konfirm, "#9333ea")
        make_card(1, 1, "Terjual", self.v_tot_terjual, "#059669")
        make_card(1, 2, "Konversi Terjual", self.v_tot_conv, "#0f766e")
        make_card(1, 3, "Est. Pendapatan", self.v_tot_rev, "#15803d")

        self.v_status = tk.StringVar(value="")

        # Bottom Hint & Close — di-pack side="bottom" SEBELUM Notebook agar tombol Tutup tidak pernah mengecil
        bot = ttk.Frame(main)
        bot.pack(side="bottom", fill="x", pady=(10, 0))
        ttk.Label(bot, text="Tips: Klik dua kali baris tanggal untuk melihat rincian & preview foto. Klik header untuk mengurutkan.",
                  font=FONT_SM, foreground="#64748b").pack(side="left")
        self.btn_close = ModernButton(bot, text="Tutup", variant="secondary", px_width=90, command=self._on_close)
        self.btn_close.pack(side="right")

        # Notebook (Tab 1: Ringkasan per Tanggal | Tab 2: Riwayat Foto Terjual)
        self.nb = ttk.Notebook(main)
        self.nb.pack(fill="both", expand=True)

        # ---- TAB 1: RINGKASAN PER TANGGAL ----
        tab_dates = ttk.Frame(self.nb, padding=(6, 8, 6, 6))
        self.nb.add(tab_dates, text="  Ringkasan per Tanggal  ")

        df_bar = ttk.Frame(tab_dates)
        df_bar.pack(fill="x", pady=(0, 6))
        ttk.Label(df_bar, text="Rentang:", font=FONT_SM, foreground="#334155").pack(side="left", padx=(0, 6))
        self.v_date_range = tk.StringVar(value="Semua")
        cb_range = ttk.Combobox(
            df_bar,
            textvariable=self.v_date_range,
            values=["Semua", "7 Hari Terakhir", "30 Hari Terakhir", "Bulan Ini"],
            state="readonly",
            width=16,
        )
        cb_range.pack(side="left", padx=(0, 10))
        cb_range.bind("<<ComboboxSelected>>", lambda e: self._apply_date_filter())

        ttk.Label(df_bar, text="Cari Tanggal:", font=FONT_SM, foreground="#334155").pack(side="left", padx=(0, 6))
        self.v_date_search = PlaceholderVar(df_bar, placeholder="Cari tanggal...")
        self.ent_date_search = ttk.Entry(df_bar, textvariable=self.v_date_search, width=16)
        self.ent_date_search.pack(side="left")
        self.v_date_search.bind_entry(self.ent_date_search)
        self.v_date_search.trace_add("write", lambda *a: self._apply_date_filter())

        self.v_date_match = tk.StringVar(value="")
