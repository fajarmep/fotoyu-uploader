    # ---------------- UI helpers ----------------
    def _on_mode_select(self, event=None):
        """Sinkronkan v_mode (internal: all/odd/even) dari pilihan Combobox."""
        display = self.v_mode_display.get()
        self.v_mode.set(self._mode_map.get(display, "all"))

    def post(self, fn):
        self.ui_queue.put(fn)

    def _poll(self):
        try:
            processed = 0
            while processed < 100:
                fn = self.ui_queue.get_nowait()
                try:
                    fn()
                except Exception:
                    pass
                processed += 1
        except queue.Empty:
            pass
        try:
            self.root.after(80, self._poll)
        except Exception:
            pass

    def _add_log_row(self, stamp, action, filename, status, info):
        tag_act = status
        act_upper = action.upper()
        if "KOMPRES" in act_upper:
            tag_act = "comp"
        elif "UPLOAD" in act_upper:
            tag_act = "up"
        elif "DUPLIKAT" in act_upper:
            tag_act = "dup"
        elif "AUTH" in act_upper:
            tag_act = "auth"
        elif "HISTORY" in act_upper:
            tag_act = "history"
        elif status == "ok":
            tag_act = "ok"
        elif status == "fail":
            tag_act = "fail"
        elif status == "skip":
            tag_act = "skip"

        self.txt_log.insert("end", f"[{stamp}] ", "time")
        self.txt_log.insert("end", f"[{act_upper}] ", tag_act)
        if filename:
            self.txt_log.insert("end", f"{filename} ", "file")
            self.txt_log.insert("end", f"-> {info}\n", "text")
        else:
            self.txt_log.insert("end", f"{info}\n", "text")

        try:
            line_count = int(self.txt_log.index("end-1c").split(".")[0])
            if line_count > 1500:
                self.txt_log.delete("1.0", "300.0")
        except Exception:
            pass

        self.txt_log.see("end")

        self.log_counts[status] = self.log_counts.get(status, 0) + 1
        self.vars["logsummary"].set(
            f"Total: {sum(self.log_counts.values())}   |   "
            f"OK: {self.log_counts.get('ok', 0)}   "
            f"Gagal: {self.log_counts.get('fail', 0)}   "
            f"Skip/Dup: {self.log_counts.get('skip', 0)}   "
            f"Info: {self.log_counts.get('info', 0)}")

    def log(self, msg):
        self.log_row("INFO", "", msg)

    def log_row(self, action, filename, info, status="info"):
        stamp = datetime.now().strftime("%H:%M:%S")
        self.post(lambda: self._add_log_row(stamp, action, filename, status, info))

    def on_clear_log(self):
        self.txt_log.delete("1.0", "end")
        self.log_counts = {"ok": 0, "fail": 0, "info": 0, "skip": 0}
        self.vars["logsummary"].set("Log dibersihkan.")

    def on_copy_log(self):
        content = self.txt_log.get("1.0", "end-1c")
        if not content:
            return
        self.root.clipboard_clear()
        self.root.clipboard_append(content)
        self.set_status("Seluruh log berhasil disalin ke clipboard.")

    def on_toggle_log(self):
        self.log_visible = not self.log_visible
        cur_w = max(self.root.winfo_width(), 880)
        if self.log_visible:
            self.logbox.pack(fill="both", expand=True, pady=(10, 0))
            self.btn_toggle_log.configure(text="Sembunyikan Log")
            self.root.minsize(840, 620)
            self.root.geometry(f"{cur_w}x690")
        else:
            self.logbox.pack_forget()
            self.btn_toggle_log.configure(text="Tampilkan Log")
            self.root.update_idletasks()
            compact_h = max(self.root.winfo_reqheight() + 10, 480)
            self.root.minsize(840, 460)
            self.root.geometry(f"{cur_w}x{compact_h}")

    def on_check_statistics(self):
        u = self.v_username.get().strip()
        p = self.v_password.get()
        if not u or not p:
            messagebox.showwarning("Cek Statistik", "Username dan Password wajib diisi di konfigurasi untuk mengecek statistik.", parent=self.root)
            return
        StatisticsWindow(
            self.root,
            self.api,
            self._ensure_token,
            u,
            p,
            default_price=self.v_price.get().strip() or "35000",
            tag_id=self.tag_id,
            complete_dir=self._get_complete_dir(),
        )

    def _get_upload_dir(self):
        p = getattr(self, "_cached_upload_dir", "") or (self.v_upload_dir.get().strip() if hasattr(self, "v_upload_dir") else "")
        return p or UPLOAD_DIR

    def _get_complete_dir(self):
        p = getattr(self, "_cached_complete_dir", "") or (self.v_complete_dir.get().strip() if hasattr(self, "v_complete_dir") else "")
        return p or COMPLETE_DIR

    def _pick_upload_dir(self):
        init = self.v_upload_dir.get().strip() or os.path.expanduser("~")
        path = filedialog.askdirectory(title="Pilih Folder Source Foto (Upload)", initialdir=init, parent=self.root)
        if not path:
            return
        norm = os.path.normpath(path)
        self.v_upload_dir.set(norm)
        self._cached_upload_dir = norm
        self._update_queue_display()
        self.log_row("FOLDER", "", f"Folder Source dipilih: {norm}", "info")

    def _pick_complete_dir(self):
        init = self.v_complete_dir.get().strip() or self.v_upload_dir.get().strip() or os.path.expanduser("~")
        path = filedialog.askdirectory(title="Pilih Folder Completed Foto Selesai", initialdir=init, parent=self.root)
        if not path:
            return
        norm = os.path.normpath(path)
        self.v_complete_dir.set(norm)
        self._cached_complete_dir = norm
        self.log_row("FOLDER", "", f"Folder Completed dipilih: {norm}", "info")

    def _update_queue_display(self):
        try:
            up_dir = self._get_upload_dir()
            mode = getattr(self, "_cached_mode", None) or (self.v_mode.get() if hasattr(self, "v_mode") else "all")
            if up_dir and os.path.isdir(up_dir):
                up_files = [f for f in list_images(up_dir) if f not in self.compress_skip]
                up_files = [f for i, f in enumerate(up_files, 1) if mode_match(os.path.basename(f), i, mode)]
                n_up = len(up_files)
            else:
                n_up = 0
            comp_files = [f for f in list_images(COMPRESS_DIR) if f not in self.upload_skip]
            n_comp = len(comp_files)
            s_up = f"{n_up:,}".replace(",", ".")
            s_comp = f"{n_comp:,}".replace(",", ".")
            self.vars["queue"].set(f"Antrean: {s_up} Source  |  {s_comp} Siap Upload")
            return n_up, n_comp
        except Exception:
            return 0, 0

    def _periodic_queue_refresh(self):
        try:
            self._update_queue_display()
        except Exception:
            pass
        try:
            self.root.after(2000, self._periodic_queue_refresh)
        except Exception:
            pass

    def on_reset_counters(self):
        self.counters = {"c_ok": 0, "c_fail": 0, "u_ok": 0, "u_fail": 0}
        for k in ("c_ok", "c_fail", "u_ok", "u_fail"):
            self.vars[k].set("0")
        self._session_up_start = None
        self._session_up_done = 0
        self._session_comp_start = None
        self._session_comp_done = 0
        self.pb.configure(value=0)
        self.log_row("INFO", "", "Counter status direset ke 0.", "info")

    def on_retry_failed(self):
        with self._fail_lock:
            n_c = len(self.compress_skip) + len(self.compress_fail_counts)
            n_u = len(self.upload_skip) + len(self.upload_fail_counts)
            self.compress_skip.clear()
            self.compress_fail_counts.clear()
            self.upload_skip.clear()
            self.upload_fail_counts.clear()
        self._update_queue_display()
        if n_c or n_u:
            self.log_row("INFO", "", f"Daftar gagal/skip direset ({n_c} kompres, {n_u} upload). File akan dicoba ulang.", "ok")
            self.set_status("Mencoba ulang file yang gagal...")
        else:
            self.log_row("INFO", "", "Tidak ada file gagal/skip yang perlu dicoba ulang.", "info")

    def on_manage_duplicates(self):
        win = tk.Toplevel(self.root)
        win.title("Kelola Riwayat Anti-Duplikat")
        win.resizable(False, False)
        win.transient(self.root)
        frm = ttk.Frame(win, padding=16)
        frm.pack(fill="both", expand=True)

        v_cnt = tk.StringVar(value=f"Total foto terindeks dalam Anti-Duplikat: {len(self.uploaded_fingerprints):,}".replace(",", "."))
        ttk.Label(frm, text="Riwayat Anti-Duplikat", font=FONT_TITLE).pack(anchor="w")
        ttk.Label(frm, textvariable=v_cnt, font=FONT, foreground="#475569").pack(anchor="w", pady=(6, 4))
        ttk.Label(
            frm,
            text="Riwayat mencegah foto yang sama diunggah dua kali.\nBersihkan riwayat hanya jika Anda ingin mengunggah ulang foto yang sama.",
            font=FONT_SM,
            foreground="#64748b",
            justify="left",
        ).pack(anchor="w", pady=(0, 12))

        def do_reindex():
            cdir = self._get_complete_dir()
            if not cdir or not os.path.isdir(cdir):
                messagebox.showwarning("Indeks Ulang", "Folder Completed belum dipilih atau tidak ditemukan.", parent=win)
                return
            def work():
                self._index_complete_dir()
                self.post(lambda: v_cnt.set(f"Total foto terindeks dalam Anti-Duplikat: {len(self.uploaded_fingerprints):,}".replace(",", ".")))
            threading.Thread(target=work, daemon=True).start()
            messagebox.showinfo("Indeks Ulang", "Proses indeks ulang Folder Completed dimulai di latar belakang.", parent=win)

        def do_clear():
            if not messagebox.askyesno(
                "Konfirmasi Hapus Riwayat",
                "Yakin ingin menghapus seluruh riwayat Anti-Duplikat?\nFoto yang sama akan bisa dikompres dan diunggah ulang.",
                parent=win,
            ):
                return
            with self.history_lock:
                self.uploaded_fingerprints.clear()
                self.pending_fingerprints.clear()
                try:
                    if os.path.exists(HISTORY_PATH):
                        os.remove(HISTORY_PATH)
                except Exception:
                    pass
            v_cnt.set("Total foto terindeks dalam Anti-Duplikat: 0")
            self.log_row("HISTORY", "", "Riwayat Anti-Duplikat dibersihkan.", "skip")

        row = ttk.Frame(frm)
        row.pack(fill="x")
        ModernButton(row, text="Indeks Ulang Completed", variant="soft_blue", px_width=150, command=do_reindex).pack(side="left", padx=(0, 6))
        ModernButton(row, text="Bersihkan Riwayat", variant="soft_red", px_width=138, command=do_clear).pack(side="left", padx=(0, 10))
        ModernButton(row, text="Tutup", variant="secondary", px_width=90, command=win.destroy).pack(side="right")

        center_popup(win, self.root)
        bring_to_front(win, self.root)
        try:
            win.grab_set()
        except Exception:
            pass

    # ---------------- Simulasi Fee Harga & Net Kreator (Real-time) ----------------
    def _on_price_change(self, *args):
        """Menampilkan estimasi Net Kreator seketika (0 ms) & menjadwalkan verifikasi API server."""
        try:
            raw_val = self.v_price.get().strip().replace(".", "").replace(",", "")
            if not raw_val:
                self.vars["fee_hint"].set("")
                return
            price = int(float(raw_val))
        except Exception:
            self.vars["fee_hint"].set("")
            return

        if price <= 0:
            self.vars["fee_hint"].set("")
            return

        # 1. Update REAL-TIME seketika (0 ms): Cek cache atau gunakan rasio resmi FotoYu (fee 15.8%)
        tag_id = getattr(self, "tag_id", None)
        cache_key = (price, tag_id or "")
        cached = getattr(self, "_fee_cache", {}).get(cache_key)
        if cached:
            net, fee = cached
        else:
            fee = round(price * 0.158)
            net = max(0, price - fee)

        if fee > 0:
            hint_txt = f"Net Kreator: {format_idr(net)} / foto (Biaya FotoYu: {format_idr(fee)})"
        else:
            hint_txt = f"Net Kreator: {format_idr(net)} / foto"
        self.vars["fee_hint"].set(hint_txt)

        # 2. Verifikasi akurat dengan API server di latar belakang (debounce 300ms)
        self._schedule_fee_check()

    def _schedule_fee_check(self):
        if getattr(self, "_fee_job", None):
            try:
                self.root.after_cancel(self._fee_job)
            except Exception:
                pass
        self._fee_job = self.root.after(300, self._start_fee_check)

    def _start_fee_check(self):
        self._fee_job = None
        try:
            raw_val = self.v_price.get().strip().replace(".", "").replace(",", "")
            price = int(float(raw_val))
        except Exception:
            return
        if price <= 0:
            return
        tag_id = getattr(self, "tag_id", None)
        threading.Thread(target=self._fee_worker, args=(price, tag_id), daemon=True).start()

    def _fee_worker(self, price, tag_id):
        try:
            if not self.api.get_token():
                u = self.v_username.get().strip() if hasattr(self, "v_username") else ""
                p = self.v_password.get() if hasattr(self, "v_password") else ""
                if u and p:
                    self._ensure_token(username=u, password=p)
            if not self.api.get_token():
                return
            raw = self.api.get_transaction_fee(price, tag_id)
            net, fee = parse_fee_summary(raw, price)
            if net is not None:
                if not hasattr(self, "_fee_cache"):
                    self._fee_cache = {}
                self._fee_cache[(price, tag_id or "")] = (net, fee or (price - net))
                # Pastikan input harga saat ini masih sama dengan yang dicek
                try:
                    cur_p = int(float(self.v_price.get().strip().replace(".", "").replace(",", "")))
                except Exception:
                    cur_p = None
                if cur_p == price:
                    if fee is not None and fee > 0:
                        txt = f"Net Kreator: {format_idr(net)} / foto (Biaya FotoYu: {format_idr(fee)})"
                    else:
                        txt = f"Net Kreator: {format_idr(net)} / foto"
                    self.post(lambda t=txt: self.vars["fee_hint"].set(t))
        except Exception:
            pass

    # ---------------- Preset Event / Profil ----------------
    def _load_presets(self):
        self._presets = {}
        if os.path.exists(PRESETS_PATH):
            try:
                with open(PRESETS_PATH, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if isinstance(data, dict):
                        self._presets = data
            except Exception:
                self._presets = {}
        self._refresh_preset_combo()

    def _save_presets_file(self):
        try:
            tmp = PRESETS_PATH + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(self._presets, f, indent=2)
            os.replace(tmp, PRESETS_PATH)
            return True
        except Exception as e:
            messagebox.showerror("Preset", f"Gagal menyimpan preset: {e}", parent=self.root)
            return False

    def _refresh_preset_combo(self, select_name=None):
        names = sorted(self._presets.keys())
        self.cb_preset.configure(values=names)
        if select_name is not None and select_name in self._presets:
            self.v_preset.set(select_name)
        elif self.v_preset.get() not in self._presets:
            self.v_preset.set("")

    def _on_preset_select(self, event=None):
        if self._running:
            return
        name = self.v_preset.get()
        p = self._presets.get(name)
        if not isinstance(p, dict):
            return
        self._apply_config_values(p)
        self._save_config_silent()
        self.log_row("PRESET", "", f"Preset '{name}' dimuat & otomatis aktif.", "ok")
        self._on_price_change()

    def _toggle_pwd_visibility(self):
        """Menampilkan atau menyembunyikan karakter password."""
        self._pwd_shown = not getattr(self, "_pwd_shown", False)
        self.entry_password._pwd_shown = self._pwd_shown
        if self._pwd_shown:
            self.entry_password.configure(show="")
            self.btn_toggle_pwd.configure(text="Tutup", variant="soft_blue")
        else:
            if not getattr(self.v_password, "_is_active", False):
                self.entry_password.configure(show="\u2022")
            else:
                self.entry_password.configure(show="")
            self.btn_toggle_pwd.configure(text="Lihat", variant="secondary")

    def on_save_preset(self):
        if self._running:
            messagebox.showwarning("Preset", "Hentikan proses terlebih dahulu sebelum mengubah preset.", parent=self.root)
            return
        dlg = tk.Toplevel(self.root)
        dlg.title("Simpan Preset Event")
        dlg.resizable(False, False)
        dlg.transient(self.root)
        frm = ttk.Frame(dlg, padding=16)
        frm.pack(fill="both", expand=True)

        ttk.Label(frm, text="Nama Preset (contoh: Car Free Day - 35rb):", font=FONT_BOLD).pack(anchor="w", pady=(0, 6))
        v_name = PlaceholderVar(frm, value=self.v_preset.get() or self.v_loc.get().strip(), placeholder="Contoh: Car Free Day - 35rb")
        ent = ttk.Entry(frm, textvariable=v_name, width=36)
        ent.pack(fill="x", pady=(0, 12))
        v_name.bind_entry(ent)
        ent.focus_set()
        ent.select_range(0, "end")

        def do_save(e=None):
            pname = v_name.get().strip()
            if not pname:
                messagebox.showwarning("Preset", "Nama preset tidak boleh kosong.", parent=dlg)
                return
            self.v_preset.set(pname)
            cfg_now = self._config_dict()
            self._presets[pname] = cfg_now
            if self._save_presets_file():
                self._refresh_preset_combo(select_name=pname)
                self._save_config_silent()
                self.log_row("PRESET", "", f"Preset '{pname}' disimpan & otomatis aktif.", "ok")
                dlg.destroy()

        ent.bind("<Return>", do_save)
        btn_row = ttk.Frame(frm)
        btn_row.pack(fill="x")
        ModernButton(btn_row, text="Batal", variant="secondary", px_width=90, command=dlg.destroy).pack(side="right", padx=(6, 0))
        ModernButton(btn_row, text="Simpan", variant="primary", px_width=90, command=do_save).pack(side="right")

        center_popup(dlg, self.root)
        bring_to_front(dlg, self.root)
        try:
            dlg.grab_set()
        except Exception:
            pass

    def on_delete_preset(self):
        if self._running:
            return
        pname = self.v_preset.get()
        if not pname or pname not in self._presets:
            messagebox.showinfo("Preset", "Pilih preset yang ingin dihapus terlebih dahulu.", parent=self.root)
            return
        if not messagebox.askyesno("Hapus Preset", f"Yakin ingin menghapus preset '{pname}'?", parent=self.root):
            return
        del self._presets[pname]
        if self._save_presets_file():
            self._refresh_preset_combo()
            self._save_config_silent()
            self.log_row("PRESET", "", f"Preset '{pname}' dihapus.", "skip")

    def _status_dot_color(self, text):
        low = str(text or "").lower()
        if any(k in low for k in ("gagal", "terputus", "maintenance", "error")):
            return "#dc2626"
        if "dijeda" in low or "mencoba ulang" in low:
            return "#d97706"
        if "dihentikan" in low:
            return "#64748b"
        if any(k in low for k in ("kompres:", "upload:", "login &", "memproses", "melanjutkan")):
            return "#2563eb"
        return "#16a34a"

    def set_status(self, text):
        if getattr(self, "_last_status_text", None) == text:
            return
        self._last_status_text = text
        dot_c = self._status_dot_color(text)
        def _upd(t=text, c=dot_c):
            self.vars["status"].set(t)
            if hasattr(self, "_status_dot"):
                try:
                    self._status_dot.configure(fg=c)
                except Exception:
                    pass
        self.post(_upd)

    def _has_source_files(self):
        """Cek apakah masih ada foto yang menunggu di Folder Source."""
        mode = getattr(self, "_cached_mode", "all")
        up_dir = self._get_upload_dir()
        if up_dir and os.path.isdir(up_dir):
            up_files = [f for f in list_images(up_dir) if f not in self.compress_skip]
            up_files = [f for i, f in enumerate(up_files, 1) if mode_match(os.path.basename(f), i, mode)]
            return bool(up_files)
        return False

    def _has_compress_files(self):
        """Cek apakah masih ada foto yang menunggu di folder internal Compress."""
        comp_files = [f for f in list_images(COMPRESS_DIR) if f not in self.upload_skip]
        return bool(comp_files)

    def _has_pending_files(self):
        """Cek apakah masih ada foto yang menunggu di Folder Source atau Compress."""
        return self._has_source_files() or self._has_compress_files()

    def _maybe_set_monitoring_status(self):
        """Set status info_bar ke 'Memantau folder...' bila sedang aktif dan tidak ada proses kompres/upload aktif."""
        if not self._running or self.stop_event.is_set() or self.pause_event.is_set():
            return
        if self._compress_busy or self._upload_busy:
            return
        if not self.api.get_token():
            return
        if not self._has_source_files() and not self._has_compress_files():
            self.set_status("Memantau folder...")
        elif not self._has_source_files():
            # Folder Source kosong & upload sedang idle -> jangan pernah biarkan tertahan di 'Berjalan...'
            if getattr(self, "_last_status_text", "") in ("Berjalan...", "Login & mulai...", "Melanjutkan upload...", "Melanjutkan kompres..."):
                self.set_status("Memantau folder...")

    def bump(self, key, n=1):
        def upd():
            self.counters[key] = self.counters.get(key, 0) + n
            val = self.counters[key]
            # Format pemisah ribuan (titik) agar rapi saat puluhan ribu foto
            self.vars[key].set(f"{val:,}".replace(",", "."))
        self.post(upd)

    # ---------------- Config ----------------
    def _config_dict(self):
        return {
            "active_preset": self.v_preset.get() if hasattr(self, "v_preset") else "",
            "username": self.v_username.get(),
            "password": self.v_password.get(),
            "price": self.v_price.get(),
            "location_name": self.v_loc.get(),
            "longitude": self.v_lon.get(),
            "latitude": self.v_lat.get(),
            "description": self.txt_desc.get("1.0", "end-1c"),
            "mode": self.v_mode.get(),
            "upload_dir": self.v_upload_dir.get().strip(),
            "complete_dir": self.v_complete_dir.get().strip(),
            "currency_id": self.cfg.get("currency_id", DEFAULT_CONFIG["currency_id"]),
            "tag_id": self.tag_id,
        }

    def _save_config_silent(self):
        """Simpan konfigurasi aktif ke config.json secara hening (dipakai saat tambah/ganti preset)."""
        self.cfg = self._config_dict()
        self._snapshot_config()
        try:
            tmp = CONFIG_PATH + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(self.cfg, f, indent=2)
            os.replace(tmp, CONFIG_PATH)
        except Exception:
            pass

    def _snapshot_config(self):
        try:
            self._cached_username = self.v_username.get().strip()
            self._cached_password = self.v_password.get()
            self._cached_price = self.v_price.get().strip()
            self._cached_loc = self.v_loc.get().strip()
            self._cached_lon = self.v_lon.get().strip()
            self._cached_lat = self.v_lat.get().strip()
            self._cached_mode = self.v_mode.get()
            self._cached_desc = self.txt_desc.get("1.0", "end-1c")
            self._cached_upload_dir = self.v_upload_dir.get().strip()
            self._cached_complete_dir = self.v_complete_dir.get().strip()
        except Exception:
            pass

    def _apply_config_values(self, data):
        self.v_username.set(data.get("username", ""))
        self.v_password.set(data.get("password", ""))
        self.v_price.set(data.get("price", DEFAULT_CONFIG["price"]))
        self.v_loc.set(data.get("location_name", ""))
        self.v_lon.set(data.get("longitude", ""))
        self.v_lat.set(data.get("latitude", ""))
        self.v_upload_dir.set(data.get("upload_dir", ""))
        self.v_complete_dir.set(data.get("complete_dir", ""))
        self.txt_desc.delete("1.0", "end")
        self.txt_desc.insert("1.0", data.get("description", ""))
        if hasattr(self, "_desc_placeholder_show"):
            self._desc_placeholder_show()
        loaded_mode = data.get("mode", "all")
        self.v_mode.set(loaded_mode)
        self.v_mode_display.set(self._mode_map_rev.get(loaded_mode, "Semua (All)"))
        self.tag_id = data.get("tag_id", DEFAULT_CONFIG["tag_id"])
        self._loc_payload_name = data.get("location_name", "")
        self._snapshot_config()
        self._update_queue_display()

    def _load_config(self):
        self.cfg = dict(DEFAULT_CONFIG)
        if os.path.exists(CONFIG_PATH):
            try:
                with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                    self.cfg.update(json.load(f))
            except Exception:
                pass
        self._apply_config_values(self.cfg)
        active_p = self.cfg.get("active_preset", "")
        if active_p and active_p in self._presets:
            self.v_preset.set(active_p)

    # ---------------- Anti-Duplikat ----------------
    def _load_history(self):
        self.uploaded_fingerprints = set()
        if os.path.exists(HISTORY_PATH):
            try:
                with open(HISTORY_PATH, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if isinstance(data, dict):
                        fps = data.get("fingerprints", {})
                        if isinstance(fps, dict):
                            self.uploaded_fingerprints = set(fps.keys())
                        elif isinstance(fps, list):
                            self.uploaded_fingerprints = set(fps)
                    elif isinstance(data, list):
                        self.uploaded_fingerprints = set(data)
            except Exception:
                pass

        if not self.uploaded_fingerprints:
            threading.Thread(target=self._index_complete_dir, daemon=True).start()
        else:
            self.log_row("HISTORY", "", f"Anti-Duplikat aktif: {len(self.uploaded_fingerprints)} foto terindeks.", "info")

    def _index_complete_dir(self):
        try:
            cdir = self._get_complete_dir()
            if not cdir or not os.path.isdir(cdir):
                return
            files = list_images(cdir)
            new_records = {}
            for f in files:
                fp = get_file_fingerprint(f)
                if fp:
                    new_records[fp] = os.path.basename(f)
            if new_records:
                self._save_history(new_records)
                self.log_row("HISTORY", "", f"Index {len(new_records)} foto di Folder Completed ke Anti-Duplikat.", "info")
        except Exception:
            pass

    def _save_history(self, new_records):
        if not new_records:
            return
        with self.history_lock:
            current_data = {"fingerprints": {}}
            if os.path.exists(HISTORY_PATH):
                try:
                    with open(HISTORY_PATH, "r", encoding="utf-8") as f:
                        current_data = json.load(f)
                except Exception:
                    current_data = {"fingerprints": {}}
            fps = current_data.setdefault("fingerprints", {})
            now_iso = datetime.now(timezone.utc).isoformat()
            for fp, name in new_records.items():
                self.uploaded_fingerprints.add(fp)
                fps[fp] = {"name": name, "uploaded_at": now_iso}
            try:
                tmp = HISTORY_PATH + ".tmp"
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump(current_data, f, indent=2)
                os.replace(tmp, HISTORY_PATH)
            except Exception:
                pass

    def on_save(self):
        self.cfg = self._config_dict()
        self._snapshot_config()
        try:
            with open(CONFIG_PATH, "w", encoding="utf-8") as f:
                json.dump(self.cfg, f, indent=2)
            self.log_row("SAVE", "", f"Konfigurasi & folder destinasi disimpan: {os.path.basename(CONFIG_PATH)}", "ok")
            messagebox.showinfo("Save", "Konfigurasi & folder destinasi berhasil disimpan.", parent=self.root)
        except Exception as e:
            messagebox.showerror("Save", f"Gagal menyimpan: {e}", parent=self.root)
        self._set_config_readonly(self._running)

    # ---------------- Autocomplete ----------------
    def _on_loc_key(self, e):
        if e.keysym in ("Up", "Down", "Return", "Escape", "Tab"):
            return
        if self._autocomplete_job:
            self.root.after_cancel(self._autocomplete_job)
        self._autocomplete_job = self.root.after(350, self._do_autocomplete)

    def _do_autocomplete(self):
        q = self.v_loc.get().strip()
        if len(q) < 2:
            self._hide_loc_list()
            return
        # Ambil kredensial langsung dari form input tanpa mewajibkan klik Save terlebih dahulu
        u = self.v_username.get().strip() if hasattr(self, "v_username") else ""
        p = self.v_password.get() if hasattr(self, "v_password") else ""
        if not u or not p:
            self._show_loc_list(["(masukkan username & password terlebih dahulu)"])
            return
        threading.Thread(target=self._autocomplete_worker, args=(q, u, p), daemon=True).start()

    def _autocomplete_worker(self, q, u=None, p=None):
        ok = self._ensure_token(username=u, password=p)
        if not ok:
            self.post(lambda: self._show_loc_list(None))
            return
        items = self.api.tree_search(q)
        results = None if items is None else parse_trees(items)
        self.post(lambda: self._show_loc_list(results))

    def _show_loc_list(self, results):
        if results is None:
            self._location_results = []
            self.loc_list.delete(0, "end")
            self.loc_list.insert("end", "(login gagal - cek username/password)")
            self._place_loc_list()
            return
        self.loc_list.delete(0, "end")
        if isinstance(results, list) and len(results) == 1 and isinstance(results[0], str):
            self._location_results = []
            self.loc_list.insert("end", results[0])
            self._place_loc_list()
            return
        self._location_results = results
        if not results:
            self.loc_list.insert("end", "(Fototree tidak ditemukan)")
            self._place_loc_list()
            return
        for r in results:
            self.loc_list.insert("end", r["name"])
        self._place_loc_list()

    def _place_loc_list(self):
        try:
            self.root.update_idletasks()
            x = self.loc_entry.winfo_rootx() - self.root.winfo_rootx()
            y = (self.loc_entry.winfo_rooty() - self.root.winfo_rooty()
                 + self.loc_entry.winfo_height())
            w = self.loc_entry.winfo_width()
            self.loc_list.place(x=x, y=y, width=w, height=140)
            self.loc_list.lift()
        except Exception:
            pass

    def _hide_loc_list(self):
        try:
            self.loc_list.place_forget()
        except Exception:
            pass

    def _on_loc_select(self, e=None):
        sel = self.loc_list.curselection()
        if not sel or not self._location_results:
            return
        if sel[0] >= len(self._location_results):
            return
        r = self._location_results[sel[0]]
        if not isinstance(r, dict):
            return
        self.v_loc.set(r["name"])
        self.v_lon.set(str(r["longitude"]))
        self.v_lat.set(str(r["latitude"]))
        self.tag_id = r["tag_id"]
        self._loc_payload_name = r.get("location_name") or r["name"]
        self._hide_loc_list()
        self.log_row("FOTOTREE", r["name"], f"{r['latitude']}, {r['longitude']}")
        self._on_price_change()

    def _pick_first_location(self):
        if self._location_results:
            self._on_loc_select()

    # ---------------- Auth ----------------
    def _ensure_token(self, username=None, password=None):
        u = username
        if not u and hasattr(self, "v_username"):
            try:
                u = self.v_username.get().strip()
            except Exception:
                u = ""
        if not u:
            u = getattr(self, "_cached_username", "") or self.cfg.get("username", "")

        p = password
        if not p and hasattr(self, "v_password"):
            try:
                p = self.v_password.get()
            except Exception:
                p = ""
        if not p:
            p = getattr(self, "_cached_password", "") or self.cfg.get("password", "")

        if not u or not p:
            return False

        with self._login_lock:
            # Jika kredensial yang diminta berbeda dari kredensial token saat ini, reset token agar login ulang
            if self._authed_creds != (None, None) and self._authed_creds != (u, p):
                self.api.set_token(None)

            if self.api.get_token():
                return True

            token = self.api.login(u, p)
            if token:
                self.api.set_token(token)
                self._authed_creds = (u, p)
                self._cached_username = u
                self._cached_password = p
                self.post(lambda: self.log_row("AUTH", "", "Login berhasil.", "ok"))
                self.post(self._on_price_change)
                return True
            self.post(lambda: self.log_row("AUTH", "", "Login gagal.", "fail"))
            return False

    # ---------------- Kontrol ----------------
    def _validate(self):
        if not self.v_username.get().strip() or not self.v_password.get():
            messagebox.showwarning("Validasi", "Username dan Password wajib diisi.", parent=self.root)
            return False
        try:
            int(float(self.v_price.get()))
        except Exception:
            messagebox.showwarning("Validasi", "Harga harus berupa angka.", parent=self.root)
            return False
        if not self.v_lon.get() or not self.v_lat.get():
            messagebox.showwarning("Validasi", "Pilih Fototree dulu agar Longitude/Latitude terisi.", parent=self.root)
            return False
        try:
            float(self.v_lon.get())
            float(self.v_lat.get())
        except Exception:
            messagebox.showwarning("Validasi", "Longitude/Latitude tidak valid.", parent=self.root)
            return False

        up_dir = self._get_upload_dir()
        comp_dir = self._get_complete_dir()
        if not up_dir or not os.path.isdir(up_dir):
            messagebox.showwarning("Validasi", "Pilih Folder Source foto terlebih dahulu dan pastikan folder tersedia.", parent=self.root)
            return False
        if not comp_dir or not os.path.isdir(comp_dir):
            messagebox.showwarning("Validasi", "Pilih Folder Completed (foto selesai) terlebih dahulu dan pastikan folder tersedia.", parent=self.root)
            return False
        norm_up = os.path.normcase(os.path.abspath(up_dir))
        norm_comp = os.path.normcase(os.path.abspath(comp_dir))
        norm_cpr = os.path.normcase(os.path.abspath(COMPRESS_DIR))
        if norm_up == norm_comp:
            messagebox.showwarning("Validasi", "Folder Source dan Folder Completed tidak boleh sama.", parent=self.root)
            return False
        if norm_up == norm_cpr or norm_comp == norm_cpr:
            messagebox.showwarning("Validasi", "Folder Source / Folder Completed tidak boleh sama dengan folder internal Compress.", parent=self.root)
            return False
        return True

    def on_start(self):
        if self._running:
            return
        if not self._validate():
            return
        # Auto-save konfigurasi ke file disk agar pengguna pertama kali tidak kehilangan input saat langsung start
        self._save_config_silent()
        ensure_dirs()
        # Jika kredensial diubah setelah stop, reset token agar login ulang
        if self._authed_creds != (None, None) and self._authed_creds != (self._cached_username, self._cached_password):
            self.api.set_token(None)
        self.compress_fail_counts.clear()
        self.compress_skip.clear()
        self.upload_fail_counts.clear()
        self.upload_skip.clear()
        self.stop_event.clear()
        self.pause_event.clear()
        self._compress_busy = False
        self._upload_busy = False
        self._session_up_start = None
        self._session_up_done = 0
        self._session_comp_start = None
        self._session_comp_done = 0
        self._run_seq += 1
        my_seq = self._run_seq
        self._running = True
        self.btn_start.configure(state="disabled")
        self.btn_pause.configure(state="normal")
        self.btn_stop.configure(state="normal")
        self._set_config_readonly(True)
        if self.api.get_token():
            if not self._has_source_files():
                self.set_status("Memantau folder...")
            else:
                self.set_status("Memproses folder source...")
        else:
            self.set_status("Login & mulai...")
        self.log_row("INFO", "", f"START - Fototree: {self.v_loc.get()} "
                                 f"({self.v_lat.get()}, {self.v_lon.get()}) | "
                                 f"Harga: {self.v_price.get()} | Mode: {self.v_mode.get()}")
        self.workers = [
            threading.Thread(target=self._compress_worker, args=(my_seq,), daemon=True),
            threading.Thread(target=self._upload_worker, args=(my_seq,), daemon=True),
        ]
        for t in self.workers:
            t.start()

    def on_pause(self):
        if not self._running:
            return
        if self.pause_event.is_set():
            self.pause_event.clear()
            self.btn_pause.configure(text="Pause")
            if not self._has_source_files() and not self._compress_busy and not self._upload_busy:
                self.set_status("Memantau folder...")
            elif self._compress_busy or self._has_source_files():
                self.set_status("Melanjutkan kompres...")
            else:
                self.set_status("Melanjutkan upload...")
            self.log("Dilanjutkan.")
        else:
            self.pause_event.set()
            self.btn_pause.configure(text="Resume")
            self.set_status("Dijeda.")
            self.log("Dijeda.")

    def on_stop(self):
        if not self._running:
            self._set_config_readonly(False)
            return
        self._run_seq += 1
        self.stop_event.set()
        self.pause_event.clear()
        self._running = False
        self._compress_busy = False
        self._upload_busy = False
        self.btn_pause.configure(state="disabled", text="Pause")
        self.btn_stop.configure(state="disabled")
        self.btn_start.configure(state="normal")
        self._set_config_readonly(False)
        self.set_status("Dihentikan.")
        self.log("STOP")

    def _on_close(self):
        self.stop_event.set()
        # Simpan konfigurasi secara hening jika form terisi agar input pengguna tidak hilang
        try:
            if hasattr(self, "v_username") and (self.v_username.get().strip() or self.v_upload_dir.get().strip()):
                self._save_config_silent()
        except Exception:
            pass
        self.root.destroy()

    def _set_config_readonly(self, ro):
        state = "readonly" if ro else "normal"
        for e in (self.entry_username, self.entry_password, self.entry_price, self.loc_entry):
            try:
                e.configure(state=state)
            except Exception:
                pass
        for b in (self.btn_pick_upload, self.btn_pick_complete, self.btn_preset_save, self.btn_preset_del):
            try:
                b.configure(state="disabled" if ro else "normal")
            except Exception:
                pass
        try:
            self.cb_preset.configure(state="disabled" if ro else "readonly")
        except Exception:
            pass
        try:
            self.txt_desc.configure(state="disabled" if ro else "normal")
            bg_c = "#f4f4f5" if ro else "white"
            self.txt_desc.configure(bg=bg_c)
            self.txt_desc.master.configure(bg=bg_c)
        except Exception:
            pass
        try:
            self.cb_mode.configure(state="disabled" if ro else "readonly")
        except Exception:
            pass

    def _interruptible_sleep(self, seconds):
        end = time.time() + seconds
        while time.time() < end:
            if self.stop_event.is_set():
                return
            while self.pause_event.is_set() and not self.stop_event.is_set():
                time.sleep(0.15)
            time.sleep(0.1)

    # ---------------- Worker: Kompres ----------------
    def _compress_worker(self, my_seq=None):
        while not self.stop_event.is_set() and (my_seq is None or self._run_seq == my_seq):
            try:
                self._compress_cycle()
                self._maybe_set_monitoring_status()
            except Exception as e:
                self.log_row("KOMPRES", "", f"Error: {e}", "fail")
            self._interruptible_sleep(POLL_INTERVAL)

    def _compress_cycle(self):
        up_dir = self._get_upload_dir()
        comp_dir = self._get_complete_dir()
        if not up_dir or not os.path.isdir(up_dir) or not comp_dir:
            return
        mode = getattr(self, "_cached_mode", "all")
        all_files = list_images(up_dir)
        if not all_files:
            return
        files = [f for f in all_files if f not in self.compress_skip]
        files = [f for i, f in enumerate(files, 1) if mode_match(os.path.basename(f), i, mode)]
        if not files:
            return
        batch = files[:COMPRESS_BULK_MAX]
        total = len(batch)
        done_count = 0
        counter_lock = threading.Lock()
        if self._session_comp_start is None:
            self._session_comp_start = time.time()
        batch_start = time.time()

        def process_one(src):
            nonlocal done_count
            if self.stop_event.is_set():
                return
            while self.pause_event.is_set() and not self.stop_event.is_set():
                time.sleep(0.15)
            name = os.path.basename(src)
            try:
                if not is_file_stable(src):
                    return

                # --- Cek Anti-Duplikat ---
                fp = get_file_fingerprint(src)
                with self.history_lock:
                    is_dup = bool(fp and fp in self.uploaded_fingerprints)
                if is_dup:
                    self.log_row("DUPLIKAT", name, "Sudah pernah diupload, lewati kompresi & pindah ke Completed", "skip")
                    with self._path_lock:
                        dest = unique_path(comp_dir, name)
                    safe_move_file(src, dest)
                    return

                size_in = os.path.getsize(src)
                if size_in > Dmf_MAX_INPUT_BYTES:
                    self._compress_fail(src, name, "melebihi 50 MB")
                    return
                with Image.open(src) as im:
                    w0, h0 = im.size
                if w0 * h0 > JTH_MAX_INPUT_PIXELS:
                    self._compress_fail(src, name, "melebihi 50 MP")
                    return
                base, _ = os.path.splitext(name)
                with self._path_lock:
                    out_path = unique_path(COMPRESS_DIR, base + ".jpg")
                ok, q, size, w, h = compress_image(src, out_path)
                if ok:
                    self.log_row("KOMPRES", name, f"{w}x{h}, q={q}, {size/1024:.0f} KB", "ok")
                    comp_name = os.path.basename(out_path)
                    with self.history_lock:
                        if fp:
                            self.pending_fingerprints[comp_name] = (fp, name)
                    with self._path_lock:
                        dest = unique_path(comp_dir, name)
                    safe_move_file(src, dest)
                    with self._fail_lock:
                        self.compress_fail_counts.pop(src, None)
                    self.bump("c_ok")
                else:
                    if os.path.exists(out_path):
                        try:
                            os.remove(out_path)
                        except Exception:
                            pass
                    self._compress_fail(src, name, "tidak mencapai <= 500 KB")
            except Exception as e:
                self._compress_fail(src, name, f"error: {e}")
            finally:
                with counter_lock:
                    done_count += 1
                    curr = done_count
                    self._session_comp_done += 1
                if not self.stop_event.is_set() and not self.pause_event.is_set():
                    elapsed = max(0.1, time.time() - batch_start)
                    rate_pm = (curr / elapsed) * 60.0
                    rem = max(0, total - curr)
                    eta_s = (rem / (curr / elapsed)) if curr > 0 else 0
                    status_msg = f"Kompres: {name} ({curr}/{total})  |  Sisa: {rem}  |  ~{rate_pm:.0f} foto/mnt"
                    if rem > 0 and elapsed >= 1.0:
                        status_msg += f"  |  ETA: {format_eta(eta_s)}"
                    self.set_status(status_msg)
                pct = (curr / max(1, total)) * 100
                self.post(lambda p=pct: self.pb.configure(value=p))

        self._compress_busy = True
        try:
            with ThreadPoolExecutor(max_workers=CPU_WORKERS) as executor:
                list(executor.map(process_one, batch))
            self.post(lambda: self.pb.configure(value=100))
        finally:
            self._compress_busy = False

    def _compress_fail(self, src, name, reason):
        with self._fail_lock:
            n = self.compress_fail_counts.get(src, 0) + 1
            self.compress_fail_counts[src] = n
            if n >= COMPRESS_FAIL_LIMIT:
                self.compress_skip.add(src)
                self.log_row("KOMPRES", name, f"SKIP PERMANEN (gagal {n}x: {reason})", "skip")
            else:
                self.log_row("KOMPRES", name, f"GAGAL ({reason}) - {n}/{COMPRESS_FAIL_LIMIT}", "fail")
        self.bump("c_fail")

    # ---------------- Worker: Upload ----------------
    def _wait_if_server_unavailable(self):
        """Cek koneksi/maintenance berkala; bila offline/maintenance, tunggu pulih tanpa membakar jatah gagal."""
        now = time.time()
        if (now - self._last_health_check) < 20.0:
            return False
        self._last_health_check = now
        state, msg = self.api.check_server_health()
        if state in ("offline", "maintenance"):
            wait_msg = msg or "Koneksi terputus / server maintenance."
            self.set_status(f"{wait_msg} Menunggu pulih...")
            self.log_row("INFO", "", f"{wait_msg} Menunggu koneksi pulih...", "skip")
            self._last_health_check = 0.0
            self._interruptible_sleep(5)
            return True
        return False

    def _upload_worker(self, my_seq=None):
        first = True
        while not self.stop_event.is_set() and (my_seq is None or self._run_seq == my_seq):
            try:
                if self._ensure_token():
                    if first:
                        first = False
                        if not self.stop_event.is_set() and not self.pause_event.is_set():
                            if not self._compress_busy and not self._upload_busy and not self._has_source_files():
                                self.set_status("Memantau folder...")
                    self._upload_cycle()
                    self._maybe_set_monitoring_status()
                else:
                    if first:
                        first = False
                        if not self.stop_event.is_set() and not self.pause_event.is_set():
                            self.set_status("Login gagal. Cek username/password.")
            except Exception as e:
                self.log_row("UPLOAD", "", f"Error: {e}", "fail")
            self._interruptible_sleep(POLL_INTERVAL)

    def _upload_cycle(self):
        files = list_images(COMPRESS_DIR)
        if not files:
            return
        files = [f for f in files if f not in self.upload_skip]
        if not files:
            return
        if self._wait_if_server_unavailable():
            return
        batch = files[:UPLOAD_BULK_MAX]
        batch_start = time.time()
        self._upload_busy = True
        try:
            for start in range(0, len(batch), CREATION_CHUNK):
                if self.stop_event.is_set():
                    return
                chunk = batch[start:start + CREATION_CHUNK]
                self._upload_chunk(chunk, start, len(batch), batch_start=batch_start)
        finally:
            self._upload_busy = False

    def _upload_chunk(self, files, offset, grand_total, batch_start=None):
        if self.stop_event.is_set():
            return
        while self.pause_event.is_set() and not self.stop_event.is_set():
            time.sleep(0.15)
        if batch_start is None:
            batch_start = time.time()

        def prep_item(f):
            try:
                with Image.open(f) as im:
                    w, h = im.size
                ext = os.path.splitext(f)[1].lstrip(".").lower()
                if ext == "jpg":
                    ext = "jpeg"
                return {
                    "original": f,
                    "upload_path": f,
                    "name": os.path.basename(f),
                    "ext": ext,
                    "width": w,
                    "height": h,
                    "size": os.path.getsize(f),
                    "signature": get_file_md5(f)
                }
            except Exception as e:
                self.log_row("UPLOAD", os.path.basename(f), f"SKIP: {e}", "skip")
                return None

        with ThreadPoolExecutor(max_workers=CPU_WORKERS) as prep_exec:
            items = [res for res in prep_exec.map(prep_item, files) if res is not None]

        if not items:
            return

        results, meta_map, relogin = self.api.presigned_urls(items)
        if relogin and self._ensure_token():
            results, meta_map, _ = self.api.presigned_urls(items)
        if not results:
            self._last_health_check = 0.0
            if not self._wait_if_server_unavailable():
                self.log_row("UPLOAD", "", "Gagal mendapatkan presigned URL.", "fail")
            return

        def _record_upload_fail(f_path, fname, reason):
            with self._fail_lock:
                n_up = self.upload_fail_counts.get(f_path, 0) + 1
                self.upload_fail_counts[f_path] = n_up
                if n_up >= UPLOAD_FAIL_LIMIT:
                    self.upload_skip.add(f_path)
                    self.log_row("UPLOAD", fname, f"SKIP PERMANEN (gagal {n_up}x: {reason})", "skip")

        work_items = []
        for item in results:
            sig = item.get("signature")
            bucket = meta_map.get(sig)
            if not bucket:
                continue
            meta = bucket.pop(0)
            url, upload_key = resolve_link(item)
            if not url:
                reason = item.get("error") or "URL kosong"
                self.log_row("UPLOAD", meta["name"], reason, "fail")
                self.bump("u_fail")
                _record_upload_fail(meta["upload_path"], meta["name"], reason)
                continue
            work_items.append((meta, url, upload_key, sig))

        entries = []
        success = []
        entries_lock = threading.Lock()
        uploaded_count = 0

        def upload_single(work):
            nonlocal uploaded_count
            if self.stop_event.is_set():
                return
            while self.pause_event.is_set() and not self.stop_event.is_set():
                time.sleep(0.15)

            meta, url, upload_key, sig = work
            ok, code = self.api.upload_s3(url, meta["upload_path"], meta["width"],
                                          meta["height"], "image/jpeg")
            with entries_lock:
                uploaded_count += 1
                curr = offset + uploaded_count
                if ok:
                    obj = {
                        "title": meta["name"],
                        "content": url,
                        "height": meta["height"],
                        "width": meta["width"],
                        "size": meta["size"],
                        "signature": sig
                    }
                    if upload_key:
                        obj["upload_key"] = upload_key
                    entries.append((obj, meta["original"]))
                    success.append(meta["original"])
                    self.log_row("UPLOAD", meta["name"], f"S3 OK ({code})", "ok")
                else:
                    self.log_row("UPLOAD", meta["name"], f"S3 GAGAL ({code})", "fail")
                    self.bump("u_fail")
                    # Jangan membakar jatah gagal permanen jika koneksi benar-benar putus (code is None)
                    if code is not None:
                        _record_upload_fail(meta["upload_path"], meta["name"], f"upload S3 ({code})")

            if not self.stop_event.is_set() and not self.pause_event.is_set():
                elapsed = max(0.1, time.time() - batch_start)
                rate_pm = (curr / elapsed) * 60.0
                rem = max(0, grand_total - curr)
                eta_s = (rem / (curr / elapsed)) if curr > 0 else 0
                status_msg = f"Upload: {meta['name']} ({curr}/{grand_total})  |  Sisa: {rem}  |  ~{rate_pm:.0f} foto/mnt"
                if rem > 0 and elapsed >= 1.0:
                    status_msg += f"  |  ETA: {format_eta(eta_s)}"
                self.set_status(status_msg)
            pct = (curr / max(1, grand_total)) * 100
            self.post(lambda p=pct: self.pb.configure(value=p))

        with ThreadPoolExecutor(max_workers=UPLOAD_WORKERS) as up_exec:
            list(up_exec.map(upload_single, work_items))

        if not entries:
            return

        loc_name = self._loc_payload_name or getattr(self, "_cached_loc", "")
        try:
            lon = float(getattr(self, "_cached_lon", 0) or 0)
            lat = float(getattr(self, "_cached_lat", 0) or 0)
        except Exception:
            lon = lat = 0.0
        location_str = json.dumps({
            "name": loc_name,
            "longitude": lon,
            "latitude": lat,
        })
        try:
            price = int(float(getattr(self, "_cached_price", 0) or 0))
        except Exception:
            price = 0
        desc = getattr(self, "_cached_desc", "")
        ok = self.api.finalize([c for c, _ in entries], entries[0][1], price,
                               location_str, desc,
                               self.cfg.get("currency_id"), self.tag_id)
        if ok:
            new_records = {}
            with self.history_lock:
                for f in success:
                    comp_name = os.path.basename(f)
                    if comp_name in self.pending_fingerprints:
                        fp, orig_name = self.pending_fingerprints.pop(comp_name)
                        new_records[fp] = orig_name
                    else:
                        fp_direct = get_file_fingerprint(f)
                        if fp_direct:
                            new_records[fp_direct] = comp_name
            if new_records:
                self._save_history(new_records)

            for f in success:
                with self._fail_lock:
                    self.upload_fail_counts.pop(f, None)
                try:
                    os.remove(f)
                except Exception:
                    pass
            self.bump("u_ok", len(success))
            self.log_row("PUBLISH", "", f"BERHASIL {len(success)} foto diunggah ke Fotoyu", "ok")
        else:
            err_detail = getattr(self.api, "last_finalize_error", "") or "publikasi ditolak server"
            self.log_row("PUBLISH", "", f"GAGAL publikasi creation ({err_detail}), file tetap di Compress", "fail")
            self.bump("u_fail", len(success))
            for f in success:
                _record_upload_fail(f, os.path.basename(f), f"finalize ({err_detail})")

    # ---------------- Buka folder ----------------
    def on_open_folders(self):
        win = tk.Toplevel(self.root)
        win.title("Buka Folder")
        win.resizable(False, False)
        win.transient(self.root)
        frm = ttk.Frame(win, padding=16)
        frm.pack(fill="both", expand=True)
        ttk.Label(frm, text="Pilih folder untuk dibuka:", font=FONT_BOLD).pack(anchor="w", pady=(0, 4))
        ttk.Label(frm, text=f"Lokasi Compress aktif: {COMPRESS_DIR}", font=FONT_SM, foreground="#64748b").pack(anchor="w", pady=(0, 10))
        row = ttk.Frame(frm)
        row.pack(anchor="w")

        def open_checked(label, path):
            if not path or not os.path.isdir(path):
                messagebox.showwarning("Buka Folder", f"{label} belum dipilih atau foldernya tidak ditemukan.", parent=win)
                return
            open_folder(path)

        def clear_compress():
            files = list_images(COMPRESS_DIR)
            if not files:
                messagebox.showinfo("Kosongkan Compress", "Folder Compress sudah kosong.", parent=win)
                return
            if not messagebox.askyesno(
                "Konfirmasi Kosongkan Compress",
                f"Hapus {len(files)} file sementara di Folder Compress?\n"
                f"({COMPRESS_DIR})\n\nFile asli Anda di Folder Completed tidak akan terpengaruh.",
                parent=win,
            ):
                return
            removed = 0
            for f in files:
                try:
                    os.remove(f)
                    removed += 1
                except Exception:
                    pass
            self.upload_skip.clear()
            self.upload_fail_counts.clear()
            self._update_queue_display()
            self.log_row("INFO", "", f"Folder Compress dibersihkan ({removed} file dihapus).", "ok")
            messagebox.showinfo("Selesai", f"{removed} file sementara di Folder Compress berhasil dihapus.", parent=win)

        ModernButton(row, text="Source", variant="soft_blue", px_width=100, command=lambda: open_checked("Source", self._get_upload_dir())).pack(side="left", padx=(0, 6))
        ModernButton(row, text="Compress", variant="secondary", px_width=100, command=lambda: open_checked("Compress", COMPRESS_DIR)).pack(side="left", padx=(0, 6))
        ModernButton(row, text="Completed", variant="soft_blue", px_width=104, command=lambda: open_checked("Completed", self._get_complete_dir())).pack(side="left", padx=(0, 6))
        ModernButton(row, text="Kosongkan Compress", variant="soft_red", px_width=146, command=clear_compress).pack(side="left", padx=(0, 10))
        ModernButton(row, text="Tutup", variant="secondary", px_width=90, command=win.destroy).pack(side="left")
        center_popup(win, self.root)
        bring_to_front(win, self.root)
        try:
            win.grab_set()
        except Exception:
            pass


def main():
    ensure_dirs()
    root = tk.Tk()
    App(root)
    root.mainloop()


if __name__ == "__main__":
    main()
