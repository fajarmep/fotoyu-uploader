        self.tree_lb.pack(side="left", fill="both", expand=True)
        lb_vsb.pack(side="right", fill="y")

    def _render_leaderboard(self):
        mode = getattr(self, "v_lb_mode", None)
        if mode is None:
            return
        m_val = mode.get()
        self._current_lb_data = []

        tot_sales = sum(r.get("sold", 0) for r in getattr(self, "rows_data", []))
        tot_sales = max(tot_sales, len(getattr(self, "sold_creations_all", [])))

        if m_val == "date":
            self.v_lb_chart_title.set("Grafik Top 10 Tanggal Terlaris (Berdasarkan Penjualan)")
            self.v_lb_tbl_title.set("Top 10 Tanggal")
            d_map = {}
            for r in getattr(self, "rows_data", []):
                s_cnt = r.get("sold", 0)
                if s_cnt > 0:
                    d_name = r.get("date") or r.get("raw_date") or "-"
                    if d_name not in d_map:
                        d_map[d_name] = {"name": d_name, "raw_name": r.get("raw_date", d_name), "sold": 0, "revenue": 0.0}
                    d_map[d_name]["sold"] += s_cnt
                    d_map[d_name]["revenue"] += float(r.get("est_rev", 0.0))
            items = sorted(d_map.values(), key=lambda x: (x["sold"], x["revenue"]), reverse=True)
            self._current_lb_data = items[:10]
        else:
            self.v_lb_chart_title.set("Grafik Top 10 Fototree Terlaris (Berdasarkan Penjualan)")
            self.v_lb_tbl_title.set("Top 10 Fototree")
            tree_map = {}
            for it in getattr(self, "sold_creations_all", []):
                t = it.get("fototree") or extract_fototree_name(it) or "Tanpa Fototree"
                if t == "-":
                    t = "Tanpa Fototree"
                if t not in tree_map:
                    tree_map[t] = {"name": t, "raw_name": t, "sold": 0, "revenue": 0.0}
                tree_map[t]["sold"] += 1
                net_p = it.get("net_price")
                if net_p is None:
                    net_p = self.get_net_creator_earning(it.get("price", self.default_price))
                tree_map[t]["revenue"] += float(net_p or 0.0)
            items = sorted(tree_map.values(), key=lambda x: (x["sold"], x["revenue"]), reverse=True)
            self._current_lb_data = items[:10]

        # Hitung persentase pangsa
        for it in self._current_lb_data:
            it["share"] = (it["sold"] / tot_sales * 100.0) if tot_sales > 0 else 0.0

        # Update Treeview
        if hasattr(self, "tree_lb"):
            self.tree_lb.delete(*self.tree_lb.get_children(""))
            for idx, it in enumerate(self._current_lb_data, 1):
                row_tag = "rank1" if idx == 1 else ("odd" if idx % 2 != 0 else "even")
                self.tree_lb.insert("", "end", values=(
                    f"#{idx}",
                    it["name"],
                    f"{it['sold']}",
                    format_idr(it["revenue"]),
                    f"{it['share']:.1f}%",
                ), tags=(row_tag,))

        # Gambar Grafik
        self._draw_lb_chart()

    def _draw_lb_chart(self):
        if not hasattr(self, "canvas_lb"):
            return
        c = self.canvas_lb
        c.delete("all")
        cw = max(c.winfo_width(), 400)
        ch = max(c.winfo_height(), 260)

        data = getattr(self, "_current_lb_data", [])
        if not data:
            c.create_text(cw // 2, ch // 2, text="Belum ada data penjualan untuk ditampilkan di grafik Leaderboard.", fill="#94a3b8", font=FONT_SM)
            return

        max_sold = max(x["sold"] for x in data) if data else 1
        n = len(data)
        pad_top = 18
        pad_bottom = 16
        row_h = max(26, min(42, int((ch - pad_top - pad_bottom) / max(1, n))))

        left_m = 175
        val_w = 185
        bar_max_w = max(60, cw - left_m - val_w - 20)

        for i, d in enumerate(data):
            y_mid = pad_top + i * row_h + row_h // 2
            rank = i + 1

            # Warna rank & bar
            if rank == 1:
                r_color = "#d97706"
                b_color = "#f59e0b"
            elif rank == 2:
                r_color = "#475569"
                b_color = "#94a3b8"
            elif rank == 3:
                r_color = "#92400e"
                b_color = "#d97706"
            else:
                r_color = "#64748b"
                b_color = "#3b82f6"

            # Rank text
            c.create_text(16, y_mid, text=f"#{rank}", fill=r_color, font=(FONT_NAME, 9, "bold"), anchor="w")

            # Nama (pangkas jika kepanjangan)
            name_txt = d["name"]
            if len(name_txt) > 19:
                name_txt = name_txt[:17] + "..."
            c.create_text(48, y_mid, text=name_txt, fill="#0f172a", font=(FONT_NAME, 9), anchor="w")

            # Batang Horizontal
            bw = int((d["sold"] / max_sold) * bar_max_w)
            bw = max(8, bw)
            bx1 = left_m
            bx2 = left_m + bw
            by1 = y_mid - 7
            by2 = y_mid + 7
            c.create_rectangle(bx1, by1, bx2, by2, fill=b_color, outline="")

            # Nilai di kanan batang
            val_txt = f"{d['sold']} Foto  •  {format_idr(d['revenue'])}  ({d['share']:.1f}%)"
            c.create_text(bx2 + 8, y_mid, text=val_txt, fill="#334155", font=(FONT_NAME, 8), anchor="w")

    def on_export_leaderboard(self):
        data = getattr(self, "_current_lb_data", [])
        if not data:
            messagebox.showinfo("Ekspor CSV", "Tidak ada data Leaderboard untuk diekspor.", parent=self)
            return

        m_val = getattr(self, "v_lb_mode", None)
        mode_str = m_val.get() if m_val else "fototree"
        cat_name = "Fototree" if mode_str == "fototree" else "Tanggal"
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        init_name = f"fotoyu_leaderboard_{mode_str}_{ts}.csv"

        path = filedialog.asksaveasfilename(
            parent=self,
            title="Simpan Leaderboard CSV",
            initialfile=init_name,
            defaultextension=".csv",
            filetypes=[("File CSV", "*.csv"), ("Semua File", "*.*")],
        )
        if not path:
            return

        try:
            with open(path, "w", newline="", encoding="utf-8-sig") as f:
                writer = csv.writer(f)
                writer.writerow(["Peringkat", cat_name, "Foto Terjual", "Est. Pendapatan (IDR)", "Pangsa Pasar (%)"])
                for idx, it in enumerate(data, 1):
                    writer.writerow([
                        f"#{idx}",
                        it.get("raw_name") or it["name"],
                        it["sold"],
                        it["revenue"],
                        f"{it['share']:.2f}%",
                    ])
            messagebox.showinfo("Ekspor CSV Berhasil", f"Data Leaderboard Top 10 {cat_name} berhasil disimpan ke:\n{path}", parent=self)
        except Exception as e:
            messagebox.showerror("Gagal Ekspor CSV", f"Terjadi kesalahan saat menyimpan CSV:\n{e}", parent=self)

    def _on_select_sold_row(self, event=None):
        sel = self.sold_tree.selection()
        if not sel:
            return
        it = self._sold_item_map.get(sel[0])
        if it:
            self.sold_preview.show_item(it)

    def _update_summary_cards(self, rows):
        tot_foto = sum(r["photos"] for r in rows)
        tot_faces = sum(r["faces"] for r in rows)
        tot_ak_plus = sum(r["ak_plus"] for r in rows)
        tot_ak_min = sum(r["ak_min"] for r in rows)
        tot_konfirm = sum(r["konfirm"] for r in rows)
        tot_terjual = sum(r["sold"] for r in rows)
        conv = (tot_terjual / tot_foto * 100.0) if tot_foto > 0 else 0.0
        est_rev = sum(r.get("est_rev", 0) for r in rows)

        self.v_tot_foto.set(f"{tot_foto:,}".replace(",", "."))
        self.v_tot_faces.set(f"{tot_faces:,}".replace(",", "."))
        self.v_tot_ak_plus.set(f"{tot_ak_plus:,}".replace(",", "."))
        self.v_tot_ak_min.set(f"{tot_ak_min:,}".replace(",", "."))
        self.v_tot_konfirm.set(f"{tot_konfirm:,}".replace(",", "."))
        self.v_tot_terjual.set(f"{tot_terjual:,}".replace(",", "."))
        self.v_tot_conv.set(f"{conv:.1f}%")
        self.v_tot_rev.set(format_idr(est_rev))

    def _apply_date_filter(self):
        rng = self.v_date_range.get()
        q = self.v_date_search.get().strip().lower()
        today = datetime.now().date()
        filtered = []
        for r in self.rows_data:
            if q and q not in r["date"].lower() and q not in r["desc"].lower():
                continue
            raw_d = r.get("raw_date", "")
            if rng != "Semua" and raw_d:
                try:
                    dt = datetime.strptime(raw_d[:10], "%Y-%m-%d").date()
                    if rng == "7 Hari Terakhir" and dt < (today - timedelta(days=7)):
                        continue
                    if rng == "30 Hari Terakhir" and dt < (today - timedelta(days=30)):
                        continue
                    if rng == "Bulan Ini" and (dt.year != today.year or dt.month != today.month):
                        continue
                except Exception:
                    pass
            filtered.append(r)

        self.tree.delete(*self.tree.get_children(""))
        for idx, r in enumerate(filtered, 1):
            tag = "odd" if idx % 2 != 0 else "even"
            tags = (tag, "sold_all") if r["sold"] > 0 and r["sold"] >= r["photos"] else (tag,)
            conv_str = f"{(r['sold'] / r['photos'] * 100.0):.1f}%" if r["photos"] > 0 else "0%"
            self.tree.insert("", "end", values=(
                r["date"], r["photos"], r["faces"], r["ak_plus"], r["ak_min"],
                r["konfirm"], r["sold"], conv_str, r["desc"]
            ), tags=tags)

        self._update_summary_cards(filtered)
        self.v_date_match.set(f"{len(filtered)} dari {len(self.rows_data)} tanggal")
        self.tree.event_generate("<Configure>")

    def _apply_sold_filter(self):
        q = self.v_sold_search.get().strip().lower()
        sel_tree = self.v_sold_tree_filter.get()
        rng = self.v_sold_date_range.get()
        today = datetime.now().date()
        self.sold_tree.delete(*self.sold_tree.get_children(""))
        self._sold_item_map.clear()
        shown = 0
        tot_net = 0.0
        for idx, it in enumerate(self.sold_creations_all, 1):
            tname = it.get("fototree") or extract_fototree_name(it) or "-"
            if sel_tree != "Semua" and tname != sel_tree:
                continue
            d_raw = (it.get("original_at") or it.get("created_at") or "")[:10]
            if rng != "Semua" and d_raw:
                try:
                    dt = datetime.strptime(d_raw[:10], "%Y-%m-%d").date()
                    if rng == "7 Hari Terakhir" and dt < (today - timedelta(days=7)):
                        continue
                    if rng == "30 Hari Terakhir" and dt < (today - timedelta(days=30)):
                        continue
                    if rng == "Bulan Ini" and (dt.year != today.year or dt.month != today.month):
                        continue
                except Exception:
                    pass
            title = str(it.get("title") or it.get("content_id") or f"Foto #{idx}")
            disp_d = format_display_date(d_raw) if d_raw else "-"
            if q and q not in title.lower() and q not in disp_d.lower() and q not in tname.lower():
                continue
            shown += 1
            price_v = it.get("price") or self.default_price
            net_v = it.get("net_price") or self.get_net_creator_earning(price_v)
            tot_net += float(net_v or 0.0)
            tag = "odd" if shown % 2 != 0 else "even"
            iid = self.sold_tree.insert("", "end", values=(
                shown,
                disp_d,
                tname,
                title,
                it.get("face_count", 0) or 0,
                it.get("found_count", 0) or 0,
                it.get("confirmed_count", 0) or 0,
                format_idr(price_v),
                format_idr(net_v),
            ), tags=(tag,))
            self._sold_item_map[iid] = it
        self.v_sold_match.set(f"{shown} foto terjual ({format_idr(tot_net)})")
        self.sold_tree.event_generate("<Configure>")

    def start_fetch(self):
        self.btn_refresh.configure(state="disabled")
        self.btn_export.configure(state="disabled")
        self.tree.delete(*self.tree.get_children())
        self.sold_tree.delete(*self.sold_tree.get_children())
        self.sold_preview.clear()
        self.creations_by_date.clear()
        self.rows_data.clear()
        self.sold_creations_all.clear()
        self._sold_item_map.clear()
        for c, title in getattr(self, "base_headers", {}).items():
            self.tree.heading(c, text=title)
        for c, title in getattr(self, "sold_base_headers", {}).items():
            self.sold_tree.heading(c, text=title)
        if hasattr(self.tree, "_sort_state"):
            self.tree._sort_state = {"col": None, "reverse": False}
        if hasattr(self.sold_tree, "_sort_state"):
            self.sold_tree._sort_state = {"col": None, "reverse": False}
        self._update_summary_cards([])
        self.v_storage.set("Memuat storage...")
        self.btn_refresh.configure(state="disabled", text="Memuat...")
        self.v_status.set("Menghubungkan ke Fotoyu...")

        threading.Thread(target=self._fetch_worker, daemon=True).start()

    def _fetch_worker(self):
        try:
            if not self.api.get_token():
                token = self.api.login(self.username, self.password)
                if token:
                    self.api.set_token(token)
                else:
                    self.post(lambda: (
                        self.btn_refresh.configure(state="normal", text="Muat Ulang"),
                        messagebox.showwarning("Statistik", "Gagal login ke akun Fotoyu. Cek username/password.", parent=self)
                    ))
                    return

            groups = self.api.get_groups(limit=50, filter_type="all")
            if groups is None:
                token = self.api.login(self.username, self.password)
                if token:
                    self.api.set_token(token)
                    groups = self.api.get_groups(limit=50, filter_type="all")
            if not groups:
                groups = []

            # Ambil kuota storage dan daftar foto terjual secara paralel
            def fetch_storage():
                try:
                    s = self.api.get_storage()
                    d = parse_storage_data(s)
                    if d.get("text"):
                        return d
                except Exception:
                    pass
                for cand_file in ("fotoyustorage.json", os.path.join(os.path.dirname(__file__), "..", "fotoyustorage.json")):
                    if os.path.isfile(cand_file):
                        try:
                            with open(cand_file, "r", encoding="utf-8") as f_local:
                                local_d = json.load(f_local)
                                for req in local_d.get("requests", []):
                                    if "creators/storage" in req.get("url", ""):
                                        t_auth = req.get("headers", {}).get("authorization")
                                        if t_auth and not self.api.get_token():
                                            self.api.set_token(t_auth.replace("Bearer ", ""))
                                            s = self.api.get_storage()
                                            d = parse_storage_data(s)
                                            if d.get("text"):
                                                return d
                        except Exception:
                            pass
                return {}

            with ThreadPoolExecutor(max_workers=2) as meta_ex:
                f_stor = meta_ex.submit(fetch_storage)
                f_sold = meta_ex.submit(self.api.get_sold_creations, 200)
                storage_data = f_stor.result() or {}
                raw_sold_items = f_sold.result() or []

            if self.stop_event.is_set():
                return

            if storage_data and storage_data.get("text"):
                st_txt = storage_data["text"]
                self.post(lambda st=st_txt: self.v_storage.set(st))
            elif storage_data and storage_data.get("used_str"):
                self.post(lambda st=storage_data["used_str"]: self.v_storage.set(f"Storage: {st}"))
            else:
                self.post(lambda: self.v_storage.set("Storage: -"))

            # Enrich foto terjual dengan detail harga asli, fototree, dan net kreator
            def enrich_sold(it):
                cid = it.get("content_id")
                if cid:
                    try:
                        det = self.api.get_creation_details(cid)
                        if det:
                            if "price" in det and det["price"]:
                                it["price"] = det["price"]
                            if "location" in det and det["location"]:
                                it["location"] = det["location"]
                            if "tags" in det and det["tags"]:
                                it["tags"] = det["tags"]
                            if "tag_nicknames" in det and det["tag_nicknames"]:
                                it["tag_nicknames"] = det["tag_nicknames"]
                    except Exception:
                        pass
                tree_name = extract_fototree_name(it)
                if tree_name:
                    it["fototree"] = tree_name
                price_val = it.get("price") or self.default_price
                it["price"] = price_val
                tag_id = None
                if isinstance(it.get("tags"), list) and it["tags"]:
                    tag_id = it["tags"][0].get("id")
                it["net_price"] = self.get_net_creator_earning(price_val, tag_id)
                return it

            sold_items = []
            if raw_sold_items:
                with ThreadPoolExecutor(max_workers=5) as ex_sold:
                    sold_items = list(ex_sold.map(enrich_sold, raw_sold_items))

            sold_by_date = {}
            for item in sold_items:
                d_str = (item.get("original_at") or item.get("created_at") or "")[:10]
                if d_str:
                    sold_by_date.setdefault(d_str, []).append(item)

            valid_groups = [g for g in groups if (g.get("date", "")[:10])]
            total_groups = len(valid_groups)
            done_lock = threading.Lock()
            done_count = 0

            def fetch_one_group(g):
                nonlocal done_count
                if self.stop_event.is_set():
                    return None
                date_str = g.get("date", "")[:10]
                count_photos = g.get("count", 0)
                c_counts = self.api.get_date_counts(date_str)
                sold_count = c_counts.get("total_sold", 0)

                date_creations = []
                ak_plus = ak_min = konfirm = faces = 0
                page = 1
                while not self.stop_event.is_set():
                    items = self.api.get_creations_page(date_str, page=page, limit=100, filter_type="available")
                    if not items:
                        break
                    date_creations.extend(items)
                    for it in items:
                        ak_plus += it.get("found_count", 0)
                        ak_min += it.get("found_count_low", 0)
                        konfirm += it.get("confirmed_count", 0)
                        faces += it.get("face_count", 0)
                        if it.get("purchase_status") == "sold":
                            sold_count += 1
                    if len(items) < 100:
                        break
                    page += 1

                # Ambil Fototree & harga sampel dari foto pertama di tanggal ini (untuk PhotoDetailWindow)
                tree_name = ""
                date_price = self.default_price
                if date_creations:
                    cid0 = date_creations[0].get("content_id")
                    if cid0:
                        try:
                            det0 = self.api.get_creation_details(cid0)
                            if det0:
                                tree_name = extract_fototree_name(det0)
                                if "price" in det0 and det0["price"]:
                                    date_price = det0["price"]
                        except Exception:
                            pass

                for it in date_creations:
                    if not it.get("fototree") and tree_name:
                        it["fototree"] = tree_name
                    if "price" not in it:
                        it["price"] = date_price

                if date_str in sold_by_date:
                    existing_ids = {c.get("content_id") for c in date_creations if c.get("content_id")}
                    for s_item in sold_by_date[date_str]:
                        cid = s_item.get("content_id")
                        if not cid or cid not in existing_ids:
                            date_creations.append(s_item)
                            ak_plus += s_item.get("found_count", 0)
                            ak_min += s_item.get("found_count_low", 0)
                            konfirm += s_item.get("confirmed_count", 0)
                            faces += s_item.get("face_count", 0)
                    sold_count = max(sold_count, len(sold_by_date[date_str]))

                # Hitung est_rev dari Net Kreator per foto terjual sebenarnya
                est_rev = 0.0
                date_sold_items = sold_by_date.get(date_str, [])
                for s in date_sold_items:
                    est_rev += s.get("net_price", self.get_net_creator_earning(s.get("price", date_price)))
                if sold_count > len(date_sold_items):
                    est_rev += (sold_count - len(date_sold_items)) * self.get_net_creator_earning(date_price)

                actual_photos = max(count_photos, len(date_creations))
                disp_date = format_display_date(date_str)

                with done_lock:
                    done_count += 1
                    curr = done_count
                self.post(lambda c=curr, tg=total_groups: (
                    self.btn_refresh.configure(text=f"Memuat {c}/{tg}..."),
                ))

                return (date_str, disp_date, date_creations, {
                    "raw_date": date_str,
                    "date": disp_date,
                    "photos": actual_photos,
                    "faces": faces,
                    "ak_plus": ak_plus,
                    "ak_min": ak_min,
                    "konfirm": konfirm,
                    "sold": sold_count,
                    "est_rev": est_rev,
                    "desc": "Tersedia" if actual_photos > sold_count else "Terjual Semua",
                })

            results = []
            if valid_groups:
                with ThreadPoolExecutor(max_workers=5) as ex:
                    for res in ex.map(fetch_one_group, valid_groups):
                        if res is not None:
                            results.append(res)

            if self.stop_event.is_set():
                return

            processed_dates = set()
            all_rows = []
            for date_str, disp_date, date_creations, row_info in results:
                processed_dates.add(date_str)
                self.creations_by_date[disp_date] = date_creations
                self.creations_by_date[date_str] = date_creations
                all_rows.append(row_info)

            for d_str, s_list in sold_by_date.items():
                if self.stop_event.is_set():
                    return
                if d_str not in processed_dates:
                    processed_dates.add(d_str)
                    s_ak_plus = sum(it.get("found_count", 0) for it in s_list)
                    s_ak_min = sum(it.get("found_count_low", 0) for it in s_list)
                    s_konfirm = sum(it.get("confirmed_count", 0) for it in s_list)
                    s_faces = sum(it.get("face_count", 0) for it in s_list)
                    disp_d_str = format_display_date(d_str)
                    self.creations_by_date[disp_d_str] = s_list
                    self.creations_by_date[d_str] = s_list
                    s_est_rev = sum(it.get("net_price", self.get_net_creator_earning(it.get("price", self.default_price))) for it in s_list)
                    all_rows.append({
                        "raw_date": d_str,
                        "date": disp_d_str,
                        "photos": len(s_list),
                        "faces": s_faces,
                        "ak_plus": s_ak_plus,
                        "ak_min": s_ak_min,
                        "konfirm": s_konfirm,
                        "sold": len(s_list),
                        "est_rev": s_est_rev,
                        "desc": "Terjual (Completed)",
                    })

            # Urutkan terbaru di atas
            all_rows.sort(key=lambda r: r.get("raw_date", ""), reverse=True)

            def finalize_ui():
                self.rows_data = all_rows
                self.sold_creations_all = list(sold_items)

                # Kumpulkan Fototree unik khusus untuk Tab 2 (Riwayat Foto Terjual)
                sold_trees = sorted(list({
                    (it.get("fototree") or extract_fototree_name(it))
                    for it in self.sold_creations_all
                    if (it.get("fototree") or extract_fototree_name(it)) and (it.get("fototree") or extract_fototree_name(it)) != "-"
                }))
                self.cb_sold_tree_filter["values"] = ["Semua"] + sold_trees

                self._apply_date_filter()
                self._apply_sold_filter()
                self._render_leaderboard()
                n = len(self.rows_data)
                self.btn_refresh.configure(state="normal", text="Muat Ulang")
                self.btn_export.configure(state="normal" if n > 0 else "disabled")

            self.post(finalize_ui)
        except Exception as e:
            import traceback
            traceback.print_exc()
            self.post(lambda err=str(e): (
                self.btn_refresh.configure(state="normal", text="Muat Ulang"),
                self.btn_export.configure(state="normal"),
                messagebox.showerror("Statistik", f"Terjadi kesalahan saat memuat data: {err}", parent=self)
            ))

    def on_double_click_row(self, event=None):
        sel = self.tree.selection()
        if not sel:
            return
        item_vals = self.tree.item(sel[0], "values")
        if not item_vals:
            return
        date_str = item_vals[0]
        creations = self.creations_by_date.get(date_str) or self.creations_by_date.get(format_display_date(date_str), [])
        PhotoDetailWindow(
            self,
            date_str,
            creations,
            api=self.api,
            complete_dir=self.complete_dir,
            default_price=self.default_price,
            net_earning_fn=self.get_net_creator_earning,
        )

    def on_export_csv(self):
        curr_tab = 0
        try:
            curr_tab = self.nb.index(self.nb.select())
        except Exception:
            curr_tab = 0

        if curr_tab == 2:
            # Ekspor Tab 3: Leaderboard
            self.on_export_leaderboard()
            return

        if curr_tab == 1:
            # Ekspor Tab 2: Riwayat Foto Terjual
            if not self.sold_tree.get_children(""):
                messagebox.showwarning("Ekspor CSV", "Belum ada data foto terjual untuk diekspor.", parent=self)
                return
            default_name = f"fotoyu_foto_terjual_{datetime.now().strftime('%Y%m%d_%H%M%S')}.csv"
            path = filedialog.asksaveasfilename(
                parent=self,
                title="Simpan Riwayat Terjual CSV",
                initialfile=default_name,
                defaultextension=".csv",
                filetypes=[("CSV Files", "*.csv"), ("All Files", "*.*")]
            )
            if not path:
                return
            try:
                with open(path, "w", newline="", encoding="utf-8-sig") as f:
                    writer = csv.writer(f)
                    writer.writerow(["#", "Tanggal", "Fototree", "Nama File / Judul", "Wajah", "Akurasi 5+", "Konfirm", "Harga", "Net Kreator"])
                    for iid in self.sold_tree.get_children(""):
                        writer.writerow(self.sold_tree.item(iid, "values"))
                messagebox.showinfo("Ekspor Berhasil", f"Data riwayat foto terjual berhasil disimpan ke:\n{path}", parent=self)
            except Exception as e:
                messagebox.showerror("Ekspor Gagal", f"Gagal mengekspor file: {e}", parent=self)
            return

        # Ekspor Tab 1: Ringkasan per Tanggal
        if not self.tree.get_children(""):
            messagebox.showwarning("Ekspor CSV", "Belum ada data statistik untuk diekspor.", parent=self)
            return
        default_name = f"fotoyu_statistik_{datetime.now().strftime('%Y%m%d_%H%M%S')}.csv"
        path = filedialog.asksaveasfilename(
            parent=self,
            title="Simpan Statistik CSV",
            initialfile=default_name,
            defaultextension=".csv",
            filetypes=[("CSV Files", "*.csv"), ("All Files", "*.*")]
        )
        if not path:
            return
        try:
            with open(path, "w", newline="", encoding="utf-8-sig") as f:
                writer = csv.writer(f)
                writer.writerow(["Tanggal", "Jumlah Foto", "Wajah", "Akurasi 5+", "Akurasi 5-", "Konfirm", "Terjual", "% Jual", "Keterangan"])
                for iid in self.tree.get_children(""):
                    writer.writerow(self.tree.item(iid, "values"))
                writer.writerow([])
                writer.writerow([
                    "TOTAL", self.v_tot_foto.get(), self.v_tot_faces.get(),
                    self.v_tot_ak_plus.get(), self.v_tot_ak_min.get(),
                    self.v_tot_konfirm.get(), self.v_tot_terjual.get(),
                    self.v_tot_conv.get(), f"Est. Rev: {self.v_tot_rev.get()}"
                ])
            messagebox.showinfo("Ekspor Berhasil", f"Statistik berhasil disimpan ke:\n{path}", parent=self)
        except Exception as e:
            messagebox.showerror("Ekspor Gagal", f"Gagal mengekspor file: {e}", parent=self)
        except Exception as e:
            messagebox.showerror("Ekspor Gagal", f"Gagal mengekspor file: {e}", parent=self)


# ============================================================
#  APLIKASI UTAMA
# ============================================================
class App:
    def __init__(self, root):
        self.root = root
        self.root.title("FotoYu Uploader")
        self.root.minsize(720, 380)

        # Set AppUserModelID agar icon taskbar Windows terpisah dan tampil sesuai icon aplikasi
        if IS_WIN:
            try:
                import ctypes
                ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID("fotoyu.uploader.app")
            except Exception:
                pass

        self._setup_window_icon()
        self._init_style()
        ensure_dirs()

        self.api = FotoyuApi()
        self.stop_event = threading.Event()
        self.pause_event = threading.Event()
        self.workers = []
        self.compress_fail_counts = {}
        self.compress_skip = set()
        self.upload_fail_counts = {}
        self.upload_skip = set()
        self.ui_queue = queue.Queue()
        self._autocomplete_job = None
        self._location_results = []
        self._login_lock = threading.Lock()
        self._path_lock = threading.Lock()
        self._fail_lock = threading.Lock()
        self.history_lock = threading.Lock()
        self.uploaded_fingerprints = set()
        self.pending_fingerprints = {}
        self._running = False
        self._compress_busy = False
        self._upload_busy = False
        self._last_status_text = None
        self._run_seq = 0
        self._authed_creds = (None, None)
        self._fee_job = None
        self._presets = {}
        self._last_health_check = 0.0
        self._session_up_start = None
        self._session_up_done = 0
        self._session_comp_start = None
        self._session_comp_done = 0
        self.tag_id = DEFAULT_CONFIG["tag_id"]
        self._loc_payload_name = ""
        self.log_visible = False
        self._cached_username = ""
        self._cached_password = ""
        self._cached_price = ""
        self._cached_loc = ""
        self._cached_lon = ""
        self._cached_lat = ""
        self._cached_mode = "all"
        self._cached_desc = ""
        self._cached_upload_dir = ""
        self._cached_complete_dir = ""
        self._fee_cache = {}
        self._fee_job = None
        self._autocomplete_job = None

        self.counters = {"c_ok": 0, "c_fail": 0, "u_ok": 0, "u_fail": 0}
        self.log_counts = {"ok": 0, "fail": 0, "info": 0, "skip": 0}
        self.vars = {
            "c_ok": tk.StringVar(value="0"),
            "c_fail": tk.StringVar(value="0"),
            "u_ok": tk.StringVar(value="0"),
            "u_fail": tk.StringVar(value="0"),
            "queue": tk.StringVar(value="Antrean: 0 Source  |  0 Siap Upload"),
            "fee_hint": tk.StringVar(value=""),
            "status": tk.StringVar(value="Siap. Isi konfigurasi & pilih folder lalu klik Start."),
            "logsummary": tk.StringVar(value="Belum ada aktivitas."),
        }

        self._build_ui()
        self._load_presets()
        self._load_config()
        self._on_price_change()
        self._load_history()
        self._update_queue_display()
        self.root.update_idletasks()
        self._center()
        self.root.protocol("WM_DELETE_WINDOW", self._on_close)
        self.root.after(80, self._poll)
        self.root.after(1500, self._periodic_queue_refresh)

    def _setup_window_icon(self):
        icon_path = get_icon_path()
        if not icon_path:
            return
        try:
            from PIL import Image, ImageTk
            im = Image.open(icon_path)
            self._icon_photo = ImageTk.PhotoImage(im)
            self.root.iconphoto(True, self._icon_photo)
            if IS_WIN:
                ico_path = os.path.splitext(icon_path)[0] + ".ico"
                if not os.path.exists(ico_path):
                    ico_path = os.path.join(os.path.dirname(icon_path), "app.ico")
                if os.path.exists(ico_path):
                    self.root.iconbitmap(ico_path)
        except Exception:
            try:
                photo = tk.PhotoImage(file=icon_path)
                self.root.iconphoto(True, photo)
                self._icon_photo = photo
            except Exception:
                pass

    def _init_style(self):
        style = ttk.Style()
        if not (IS_WIN or IS_MAC):
            try:
                style.theme_use("clam")
            except Exception:
                pass
        try:
            style.configure("Treeview", rowheight=26, font=FONT, relief="flat", borderwidth=0)
            style.configure("Treeview.Heading", font=FONT_BOLD, foreground="#0f172a")
            style.map("Treeview",
                      background=[("selected", "#dbeafe")],
                      foreground=[("selected", "#1e3a8a")])
            # Hilangkan border luar kotak Treeview agar bersih dan menyatu dengan window
            style.layout("Treeview", [
                ("Treeview.padding", {"sticky": "nswe", "children": [
                    ("Treeview.treearea", {"sticky": "nswe"})
                ]})
            ])
            # Warna judul LabelFrame yang tegas & modern lintas OS
            style.configure("TLabelframe.Label", font=FONT_BOLD, foreground="#1e3a8a")
            # Standarisasi padding & ukuran seragam untuk Button, Entry, Toolbutton, dan Combobox
            style.configure("TButton", font=FONT, padding=(12, 5))
            style.configure("TEntry", font=FONT, padding=(8, 5))
            style.configure("Toolbutton", font=FONT, padding=(10, 6))
            style.configure("TCombobox", font=FONT, padding=(8, 6) if IS_WIN else (8, 5))
        except Exception:
            pass

    # ---------------- Window helpers ----------------
    def _center(self):
        self.root.update_idletasks()
        sw = self.root.winfo_screenwidth()
        sh = self.root.winfo_screenheight()
        # Log default disembunyikan, pakai tinggi compact yang pas
        w = max(self.root.winfo_reqwidth() + 10, 880)
        h = max(self.root.winfo_reqheight() + 10, 480)
        w = min(w, sw - 40)
        h = min(h, sh - 80)
        self.root.geometry(f"{w}x{h}+{max(0, (sw - w) // 2)}+{max(0, (sh - h) // 3)}")
        self.root.minsize(840, 460)

    # ---------------- UI ----------------
    def _build_ui(self):
        main = ttk.Frame(self.root, padding=10)
        main.pack(fill="both", expand=True)

        # ── Info bar (keterangan) dengan indikator status warna hidup ─────────
        info_border = tk.Frame(main, bg="#cbd5e1", bd=0, highlightthickness=0)
        info_border.pack(side="bottom", fill="x", pady=(4, 0))
        info_inner = tk.Frame(info_border, bg="#ffffff", padx=10, pady=5, bd=0, highlightthickness=0)
        info_inner.pack(fill="both", expand=True, padx=1, pady=1)
        self._status_dot = tk.Label(info_inner, text="\u25cf", bg="#ffffff", fg="#16a34a", font=(FONT_NAME, 10, "bold"))
        self._status_dot.pack(side="left", padx=(0, 6))
        self.info_bar = tk.Label(
            info_inner,
            textvariable=self.vars["status"],
            bg="#ffffff",
            fg="#1e293b",
            anchor="w",
            width=1,
            font=FONT_SM,
        )
        self.info_bar.pack(side="left", fill="x", expand=True)

        # ── Tombol toolbar – di-pack setelah info_bar (di atasnya) ───────────
        btns = ttk.Frame(main)
        btns.pack(side="bottom", fill="x", pady=(8, 4))
        self.btns_frame = btns

        # ── Baris atas: Konfigurasi (kiri) | kolom kanan (Mode + Status) ─────
        toprow = ttk.Frame(main)
        toprow.pack(fill="x")

        # Konfigurasi — kiri, expand
        cfg = ttk.LabelFrame(toprow, text="Konfigurasi", padding=10)
        cfg.pack(side="left", fill="both", expand=True)

        self.v_preset = tk.StringVar(value="")
        self.v_username = PlaceholderVar(cfg, placeholder="Masukkan username FotoYu")
        self.v_password = PlaceholderVar(cfg, placeholder="Masukkan password")
        self.v_price = PlaceholderVar(cfg, placeholder="Contoh: 35000")
